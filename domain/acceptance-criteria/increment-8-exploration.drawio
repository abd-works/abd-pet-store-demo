<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Story Map" id="story-map"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="browse-product-catalog" value="Browse Product Catalog" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="800" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details" value="View Product Details" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="195" width="260" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details/read-customer-reviews" value="Read Customer Reviews" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details/read-customer-reviews/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer views a &lt;i&gt;Product Details Page&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Aggregate Star Rating&lt;/i&gt; is displayed prominently near the product name&#10;&lt;b&gt;AND&lt;/b&gt; the individual &lt;i&gt;Customer Reviews&lt;/i&gt; are listed below the product details" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details/read-customer-reviews/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; a product has no reviews yet&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Aggregate Star Rating&lt;/i&gt; is not shown (not shown as zero)&#10;&lt;b&gt;AND&lt;/b&gt; a &quot;be the first to review&quot; prompt appears" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details/read-customer-reviews/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; there are many reviews&#10;&lt;b&gt;THEN&lt;/b&gt; the reviews are paginated or lazy-loaded&#10;&lt;b&gt;AND&lt;/b&gt; sort controls are provided: newest, oldest, highest rating, lowest rating" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details/read-customer-reviews/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; a review includes &lt;i&gt;Review Photos&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; thumbnails are shown inline with the review text&#10;&lt;b&gt;AND&lt;/b&gt; selecting a thumbnail opens the image at full size" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/review-products" value="Review Products" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="295" y="195" width="520" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/review-products/submit-written-review-with-star-rating" value="Submit Written Review with Star Rating" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="300" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="browse-product-catalog/review-products/submit-written-review-with-star-rating/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a logged-in customer opens the review form on a &lt;i&gt;Product Details Page&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the form collects a &lt;i&gt;Star Rating&lt;/i&gt; (1-5) and a written review (free text)&#10;&lt;b&gt;AND&lt;/b&gt; the customer must have purchased the product to leave a review" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/review-products/submit-written-review-with-star-rating/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer submits a valid review&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Customer Review&lt;/i&gt; is associated with the &lt;i&gt;Product&lt;/i&gt; and the customer's &lt;i&gt;Customer Account&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the review is visible on the &lt;i&gt;Product Details Page&lt;/i&gt; (newest first or by helpfulness)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/review-products/submit-written-review-with-star-rating/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has not purchased the product&#10;&lt;b&gt;THEN&lt;/b&gt; the review form is hidden or shows &quot;purchase this product to leave a review&quot;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/review-products/submit-written-review-with-star-rating/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; a guest customer tries to leave a review&#10;&lt;b&gt;THEN&lt;/b&gt; a prompt to log in or register is shown&#10;&lt;b&gt;BUT&lt;/b&gt; the product page is not navigated away from" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/review-products/submit-written-review-with-star-rating/ac-4" value="&lt;b&gt;WHEN&lt;/b&gt; the customer submits a review with a star rating but no written text&#10;&lt;b&gt;THEN&lt;/b&gt; the review is accepted (written text is optional; star rating is required)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="685" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/review-products/submit-photo-review" value="Submit Photo Review" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="browse-product-catalog/review-products/submit-photo-review/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer submits a review (see &lt;i&gt;Submit Written Review with Star Rating&lt;/i&gt;)&#10;&lt;b&gt;THEN&lt;/b&gt; an optional photo upload field allows attaching one or more &lt;i&gt;Review Photos&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/review-products/submit-photo-review/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer attaches &lt;i&gt;Review Photos&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the images are displayed alongside the review on the &lt;i&gt;Product Details Page&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the photos are viewable in a lightbox or gallery format" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/review-products/submit-photo-review/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer uploads a file that is not a supported image format or exceeds size limits&#10;&lt;b&gt;THEN&lt;/b&gt; the upload shows a validation error&#10;&lt;b&gt;BUT&lt;/b&gt; the review text and star rating are not lost" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/review-products/submit-photo-review/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer submits a review without photos&#10;&lt;b&gt;THEN&lt;/b&gt; the review is accepted as a standard written review (photos are optional)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account" value="Manage Customer Account" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="120" width="270" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile" value="Manage Profile" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="195" width="260" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/set-communication-preferences" value="Set Communication Preferences" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="840" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/set-communication-preferences/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens &lt;i&gt;Communication Preferences&lt;/i&gt; from account settings&#10;&lt;b&gt;THEN&lt;/b&gt; the available marketing categories are listed (promotions, recommendations, restock alerts, events)&#10;&lt;b&gt;AND&lt;/b&gt; each shows the current opt-in/opt-out status" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="840" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/set-communication-preferences/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opts out of a marketing category&#10;&lt;b&gt;THEN&lt;/b&gt; the preference is saved immediately&#10;&lt;b&gt;AND&lt;/b&gt; no marketing emails of that category are sent to the customer" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="840" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/set-communication-preferences/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; a new marketing category is added in a future increment&#10;&lt;b&gt;THEN&lt;/b&gt; the default is opt-out (the customer must explicitly opt in)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="840" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications" value="Manage Notifications" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="120" width="2430" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications" value="Send Transactional Notifications" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1115" y="195" width="580" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-order-confirmation" value="Send Order Confirmation" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1120" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-order-confirmation/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; an order is confirmed (payment successful)&#10;&lt;b&gt;THEN&lt;/b&gt; the system sends an &lt;i&gt;Order Confirmation Notification&lt;/i&gt; to the customer&#10;&lt;b&gt;AND&lt;/b&gt; the notification includes: order number, items, total, delivery option, and estimated delivery/pickup" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1120" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-order-confirmation/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has disabled order-related notifications in &lt;i&gt;Notification Preferences&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Order Confirmation Notification&lt;/i&gt; is still sent — it is a mandatory transactional notification" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1120" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-order-confirmation/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the email delivery system is unavailable&#10;&lt;b&gt;THEN&lt;/b&gt; the notification is queued for retry" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1120" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-shipping-update-with-tracking" value="Send Shipping Update with Tracking" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1380" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-shipping-update-with-tracking/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the order status changes to &lt;i&gt;Shipped&lt;/i&gt; and a &lt;i&gt;Tracking Number&lt;/i&gt; is available&#10;&lt;b&gt;THEN&lt;/b&gt; the system sends a &lt;i&gt;Shipping Update Notification&lt;/i&gt; to the customer&#10;&lt;b&gt;AND&lt;/b&gt; the notification includes: order number, tracking number, carrier link, and estimated delivery date" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-shipping-update-with-tracking/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; additional status changes occur (e.g. &lt;i&gt;Out for Delivery&lt;/i&gt;, &lt;i&gt;Delivered&lt;/i&gt;)&#10;&lt;b&gt;THEN&lt;/b&gt; the system sends follow-up notifications if carrier data is available" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-shipping-update-with-tracking/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has disabled shipping notifications in &lt;i&gt;Notification Preferences&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the initial shipping notification is still sent (mandatory transactional)&#10;&lt;b&gt;BUT&lt;/b&gt; optional follow-up status updates respect the preference" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-click-and-collect-ready-notification" value="Send Click-and-Collect Ready Notification" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1640" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications" value="Send Marketing Notifications" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1705" y="195" width="1300" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/opt-in-to-marketing-email-list" value="Opt In to Marketing Email List" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1710" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/opt-in-to-marketing-email-list/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opts in to promotional emails via &lt;i&gt;Communication Preferences&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the customer is added to the &lt;i&gt;Marketing Email List&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the opt-in is recorded with a timestamp" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1710" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/opt-in-to-marketing-email-list/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opts in during account registration or checkout&#10;&lt;b&gt;THEN&lt;/b&gt; the opt-in checkbox is unchecked by default (opt-in must be affirmative)&#10;&lt;b&gt;AND&lt;/b&gt; if checked, the customer is added to the &lt;i&gt;Marketing Email List&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1710" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/opt-in-to-marketing-email-list/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has not opted in&#10;&lt;b&gt;THEN&lt;/b&gt; no marketing emails are sent to them — zero exceptions" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1710" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-promotional-email" value="Send Promotional Email" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1970" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-promotional-email/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; admin creates and sends a &lt;i&gt;Promotional Email&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the email is delivered only to customers on the &lt;i&gt;Marketing Email List&lt;/i&gt; who have opted in to the promotions category" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1970" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-promotional-email/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; a customer on the list has since opted out&#10;&lt;b&gt;THEN&lt;/b&gt; the email is not delivered to that customer&#10;&lt;b&gt;AND&lt;/b&gt; their opt-out is respected even if the email batch was queued before the opt-out" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1970" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-promotional-email/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the email includes an unsubscribe link&#10;&lt;b&gt;THEN&lt;/b&gt; clicking the link immediately opts the customer out of the promotions category&#10;&lt;b&gt;AND&lt;/b&gt; the customer sees a &quot;you've been unsubscribed&quot; confirmation page" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1970" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-personalized-recommendation" value="Send Personalized Recommendation" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2230" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-personalized-recommendation/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the system generates a &lt;i&gt;Personalized Recommendation&lt;/i&gt; for a customer&#10;&lt;b&gt;THEN&lt;/b&gt; the recommendation is based on purchase history, browsing patterns, or pet-related products&#10;&lt;b&gt;AND&lt;/b&gt; it is sent only if the customer has opted in to the recommendations category in &lt;i&gt;Communication Preferences&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2230" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-personalized-recommendation/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has no purchase history or browsing data&#10;&lt;b&gt;THEN&lt;/b&gt; no &lt;i&gt;Personalized Recommendation&lt;/i&gt; is sent (rather than sending generic suggestions)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2230" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-personalized-recommendation/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the recommended product is &lt;i&gt;Out of Stock&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; it is excluded from the recommendation (do not recommend unavailable products)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2230" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-restock-alert" value="Send Restock Alert" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2490" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-restock-alert/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a product's &lt;i&gt;Stock Availability&lt;/i&gt; transitions from &lt;i&gt;Out of Stock&lt;/i&gt; to &lt;i&gt;In Stock&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system sends a &lt;i&gt;Restock Alert&lt;/i&gt; to each customer who has opted in to restock alerts and has the product on their &lt;i&gt;Wishlist&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2490" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-restock-alert/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has not opted in to restock alerts&#10;&lt;b&gt;THEN&lt;/b&gt; no alert is sent even if the product is on their wishlist" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2490" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-restock-alert/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the product goes back out of stock before the customer acts on the alert&#10;&lt;b&gt;THEN&lt;/b&gt; the product page shows the updated &lt;i&gt;Out of Stock&lt;/i&gt; status (the alert is best-effort, not a guarantee of availability)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2490" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-in-store-event-notification" value="Send In-Store Event Notification" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2750" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-in-store-event-notification/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; admin creates an in-store event (adoption day, pet grooming workshop, etc.)&#10;&lt;b&gt;THEN&lt;/b&gt; the system sends &lt;i&gt;In-Store Event Notifications&lt;/i&gt; to opted-in customers whose preferred store matches the event location" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2750" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-in-store-event-notification/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has not set a preferred store&#10;&lt;b&gt;THEN&lt;/b&gt; no event notification is sent (the system does not guess proximity)&#10;&lt;b&gt;BUT&lt;/b&gt; the event is visible on the store's detail page for walk-in discovery" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2750" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-marketing-notifications/send-in-store-event-notification/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has opted out of event notifications&#10;&lt;b&gt;THEN&lt;/b&gt; no alert is sent" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2750" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/manage-notification-preferences" value="Manage Notification Preferences" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3015" y="195" width="520" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/manage-notification-preferences/set-notification-preferences" value="Set Notification Preferences" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="3020" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/manage-notification-preferences/set-notification-preferences/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens &lt;i&gt;Notification Preferences&lt;/i&gt; from account settings&#10;&lt;b&gt;THEN&lt;/b&gt; the available notification categories are listed (order updates, shipping, appointments, returns)&#10;&lt;b&gt;AND&lt;/b&gt; each category shows the current setting (on/off, email/SMS if applicable)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3020" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/manage-notification-preferences/set-notification-preferences/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer toggles a notification category&#10;&lt;b&gt;THEN&lt;/b&gt; the preference is saved immediately&#10;&lt;b&gt;AND&lt;/b&gt; future notifications respect the updated preference" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3020" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/manage-notification-preferences/set-notification-preferences/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer disables all transactional notifications&#10;&lt;b&gt;THEN&lt;/b&gt; critical notifications (e.g. order confirmation, refund completion) are still sent — they are non-optional&#10;&lt;b&gt;AND&lt;/b&gt; a note explains that some notifications cannot be disabled" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3020" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/manage-notification-preferences/unsubscribe-from-marketing-emails" value="Unsubscribe from Marketing Emails" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="3280" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/manage-notification-preferences/unsubscribe-from-marketing-emails/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer clicks the unsubscribe link in any marketing email&#10;&lt;b&gt;THEN&lt;/b&gt; the customer is immediately opted out of that marketing category&#10;&lt;b&gt;AND&lt;/b&gt; a &quot;you've been unsubscribed&quot; confirmation page is shown" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3280" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/manage-notification-preferences/unsubscribe-from-marketing-emails/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer unsubscribes via the &lt;i&gt;Communication Preferences&lt;/i&gt; page&#10;&lt;b&gt;THEN&lt;/b&gt; the change takes effect immediately&#10;&lt;b&gt;AND&lt;/b&gt; no further marketing emails of that category are sent" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3280" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/manage-notification-preferences/unsubscribe-from-marketing-emails/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer unsubscribes from all marketing categories&#10;&lt;b&gt;THEN&lt;/b&gt; transactional notifications (order confirmations, shipping, appointments) are unaffected" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3280" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="publish-content" value="Publish Content" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3550" y="120" width="100" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>