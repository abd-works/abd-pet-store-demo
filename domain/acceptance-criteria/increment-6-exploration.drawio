<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Story Map" id="story-map"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="browse-available-pets" value="Browse Available Pets" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1320" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery" value="Explore Pet Gallery" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="195" width="780" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/browse-pets-by-species" value="Browse Pets by Species" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/browse-pets-by-species/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens the &lt;i&gt;Pet Gallery&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; pets are grouped or filterable by &lt;i&gt;Species&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; each &lt;i&gt;Pet Card&lt;/i&gt; shows the pet's photo, name, breed, species, and which &lt;i&gt;Store&lt;/i&gt; it is at" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/browse-pets-by-species/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects a &lt;i&gt;Species&lt;/i&gt; filter&#10;&lt;b&gt;THEN&lt;/b&gt; only pets of that species are shown&#10;&lt;b&gt;AND&lt;/b&gt; the filter is visually active so the customer knows it is applied" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/browse-pets-by-species/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; no pets of the selected &lt;i&gt;Species&lt;/i&gt; are currently available&#10;&lt;b&gt;THEN&lt;/b&gt; the gallery shows a &quot;no pets available in this category right now&quot; message&#10;&lt;b&gt;BUT&lt;/b&gt; the filter remains active and other species options are visible for selection" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/view-pet-profile" value="View Pet Profile" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="290" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/view-pet-profile/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens a &lt;i&gt;Pet Profile Page&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the page shows: &lt;i&gt;Pet Photo Gallery&lt;/i&gt;, name, species, breed, age (approximate if unknown), &lt;i&gt;Temperament Notes&lt;/i&gt;, and the &lt;i&gt;Store&lt;/i&gt; where the pet is located" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/view-pet-profile/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the pet's &lt;i&gt;Pet Status&lt;/i&gt; is &lt;i&gt;Available&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the profile shows a &quot;Book a Visit&quot; action linking to the appointment flow" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/view-pet-profile/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the pet's &lt;i&gt;Pet Status&lt;/i&gt; is &lt;i&gt;Adopted&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the profile shows an &quot;Adopted&quot; badge&#10;&lt;b&gt;AND&lt;/b&gt; the &quot;Book a Visit&quot; action is hidden or disabled&#10;&lt;b&gt;BUT&lt;/b&gt; the profile remains viewable (adopted pets are not deleted from the gallery)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/view-pet-profile/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the pet has no &lt;i&gt;Temperament Notes&lt;/i&gt; yet&#10;&lt;b&gt;THEN&lt;/b&gt; the field is omitted from the profile (not shown as blank)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/view-pet-store-location-and-distance" value="View Pet Store Location and Distance" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="550" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/view-pet-store-location-and-distance/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer views a &lt;i&gt;Pet Profile Page&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the pet's &lt;i&gt;Store&lt;/i&gt; is shown with name, address, and operating hours" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="550" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/view-pet-store-location-and-distance/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has shared their location or entered a postcode (from Increment 1)&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Distance&lt;/i&gt; from &lt;i&gt;Customer Location&lt;/i&gt; to the pet's &lt;i&gt;Store&lt;/i&gt; is displayed" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="550" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/view-pet-store-location-and-distance/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has not shared location&#10;&lt;b&gt;THEN&lt;/b&gt; no &lt;i&gt;Distance&lt;/i&gt; is shown&#10;&lt;b&gt;AND&lt;/b&gt; a prompt to share location or enter postcode is displayed" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="550" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/explore-pet-gallery/view-pet-store-location-and-distance/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects the &lt;i&gt;Store&lt;/i&gt; name or address on the &lt;i&gt;Pet Profile Page&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Store Detail&lt;/i&gt; page opens (the same store detail from Increment 1)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="550" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/manage-pet-listings" value="Manage Pet Listings" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="815" y="195" width="520" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/manage-pet-listings/update-pet-profile" value="Update Pet Profile" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="820" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="browse-available-pets/manage-pet-listings/update-pet-profile/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens a &lt;i&gt;Customer Pet Profile&lt;/i&gt; for editing&#10;&lt;b&gt;THEN&lt;/b&gt; all fields are editable: name, species, breed, age, and photo" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/manage-pet-listings/update-pet-profile/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer saves changes&#10;&lt;b&gt;THEN&lt;/b&gt; the updated profile is persisted immediately&#10;&lt;b&gt;AND&lt;/b&gt; any personalised recommendations that reference pet data reflect the update on the next recommendation cycle" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/manage-pet-listings/update-pet-profile/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer deletes a &lt;i&gt;Customer Pet Profile&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the profile is removed from &quot;My Pets&quot;&#10;&lt;b&gt;AND&lt;/b&gt; the deletion is confirmed with a &quot;are you sure&quot; prompt" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/manage-pet-listings/mark-pet-as-adopted" value="Mark Pet as Adopted" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="browse-available-pets/manage-pet-listings/mark-pet-as-adopted/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Store Staff&lt;/i&gt; marks a pet as &lt;i&gt;Adopted&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Pet Status&lt;/i&gt; transitions from &lt;i&gt;Available&lt;/i&gt; to &lt;i&gt;Adopted&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the &quot;Book a Visit&quot; action is disabled on the &lt;i&gt;Pet Profile Page&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/manage-pet-listings/mark-pet-as-adopted/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the pet has upcoming appointments at the time of adoption&#10;&lt;b&gt;THEN&lt;/b&gt; the system triggers a &lt;i&gt;Pet Adopted Before Visit Notification&lt;/i&gt; for each affected customer (see that story)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-available-pets/manage-pet-listings/mark-pet-as-adopted/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Store Staff&lt;/i&gt; attempts to mark an already-adopted pet as adopted again&#10;&lt;b&gt;THEN&lt;/b&gt; the system shows a &quot;pet is already adopted&quot; message&#10;&lt;b&gt;BUT&lt;/b&gt; no status change occurs" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit" value="Book Pet Visit" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="120" width="2090" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit" value="Schedule Visit" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1355" y="195" width="1040" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/view-available-time-slots-at-store" value="View Available Time Slots at Store" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1360" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/view-available-time-slots-at-store/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer initiates the appointment booking flow from a pet profile&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Appointment Calendar&lt;/i&gt; shows &lt;i&gt;Available Time Slots&lt;/i&gt; at the pet's &lt;i&gt;Store&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; slots are shown for the next N days (configurable by store, e.g. 14 or 30 days)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1360" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/view-available-time-slots-at-store/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; a &lt;i&gt;Time Slot&lt;/i&gt; is already booked by another customer&#10;&lt;b&gt;THEN&lt;/b&gt; that slot does not appear in the &lt;i&gt;Available Time Slots&lt;/i&gt; list" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1360" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/view-available-time-slots-at-store/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; no &lt;i&gt;Time Slots&lt;/i&gt; are available within the displayed date range&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Appointment Calendar&lt;/i&gt; shows a &quot;no slots available — try a later date&quot; message" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1360" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/select-date-and-time-slot" value="Select Date and Time Slot" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1620" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/select-date-and-time-slot/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects a &lt;i&gt;Time Slot&lt;/i&gt; from the &lt;i&gt;Appointment Calendar&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Selected Slot&lt;/i&gt; is highlighted and held temporarily (e.g. 10 minutes) to prevent double-booking during the booking flow&#10;&lt;b&gt;AND&lt;/b&gt; the customer proceeds to the confirmation step" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1620" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/select-date-and-time-slot/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the temporary hold expires before the customer confirms&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Selected Slot&lt;/i&gt; is released back to the &lt;i&gt;Available Time Slots&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the customer is notified that the slot is no longer held and must re-select" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1620" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/select-date-and-time-slot/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; two customers select the same &lt;i&gt;Time Slot&lt;/i&gt; simultaneously&#10;&lt;b&gt;THEN&lt;/b&gt; only the first to confirm gets the booking&#10;&lt;b&gt;AND&lt;/b&gt; the second customer is notified that the slot is no longer available and must pick another" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1620" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/add-visit-note" value="Add Visit Note" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1880" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/add-visit-note/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer is in the appointment confirmation step&#10;&lt;b&gt;THEN&lt;/b&gt; an optional &lt;i&gt;Visit Note&lt;/i&gt; field is available&#10;&lt;b&gt;AND&lt;/b&gt; the field accepts up to a character limit (e.g. 500 characters)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1880" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/add-visit-note/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer leaves the &lt;i&gt;Visit Note&lt;/i&gt; blank&#10;&lt;b&gt;THEN&lt;/b&gt; the appointment proceeds without a note&#10;&lt;b&gt;AND&lt;/b&gt; the staff view shows no note (not &quot;empty&quot; or &quot;N/A&quot;)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1880" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/add-visit-note/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer submits a &lt;i&gt;Visit Note&lt;/i&gt; that exceeds the character limit&#10;&lt;b&gt;THEN&lt;/b&gt; the form shows a validation error&#10;&lt;b&gt;BUT&lt;/b&gt; the appointment is not submitted until the note is within limits" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1880" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/confirm-appointment-booking" value="Confirm Appointment Booking" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2140" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/confirm-appointment-booking/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a logged-in customer confirms the appointment&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Appointment Booking&lt;/i&gt; is created with: pet, store, date/time, and optional visit note&#10;&lt;b&gt;AND&lt;/b&gt; the customer sees the &lt;i&gt;Appointment Confirmation Page&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; an &lt;i&gt;Appointment Confirmation Email&lt;/i&gt; is sent to the customer's email" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2140" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/confirm-appointment-booking/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; a guest (not logged in) attempts to confirm an appointment&#10;&lt;b&gt;THEN&lt;/b&gt; the system blocks the booking and prompts the customer to log in or register&#10;&lt;b&gt;AND&lt;/b&gt; explains that appointments require a customer account&#10;&lt;b&gt;BUT&lt;/b&gt; the selected slot remains temporarily held so the customer doesn't lose it" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2140" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/confirm-appointment-booking/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the booking is confirmed&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Time Slot&lt;/i&gt; transitions from available to booked&#10;&lt;b&gt;AND&lt;/b&gt; the slot is no longer shown to other customers" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2140" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/schedule-visit/confirm-appointment-booking/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the confirmation email fails to send&#10;&lt;b&gt;THEN&lt;/b&gt; the booking is still created (email is not a gate)&#10;&lt;b&gt;AND&lt;/b&gt; the email is queued for retry" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2140" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments" value="Manage Appointments" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2405" y="195" width="780" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/view-upcoming-and-past-appointments" value="View Upcoming and Past Appointments" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2410" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/view-upcoming-and-past-appointments/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens their &lt;i&gt;Appointment List&lt;/i&gt; from the account area&#10;&lt;b&gt;THEN&lt;/b&gt; upcoming appointments are shown first (soonest at top), followed by past appointments&#10;&lt;b&gt;AND&lt;/b&gt; each entry shows: pet name, pet photo, store, date/time, and visit note (if any)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2410" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/view-upcoming-and-past-appointments/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has no appointments&#10;&lt;b&gt;THEN&lt;/b&gt; the list shows an empty state with a prompt to browse the &lt;i&gt;Pet Gallery&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2410" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/view-upcoming-and-past-appointments/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; an upcoming appointment's pet has been marked as &lt;i&gt;Adopted&lt;/i&gt; (see &lt;i&gt;Mark Pet as Adopted&lt;/i&gt;)&#10;&lt;b&gt;THEN&lt;/b&gt; the appointment entry shows a &quot;pet adopted&quot; badge&#10;&lt;b&gt;AND&lt;/b&gt; &quot;Cancel&quot; and &quot;Browse other pets&quot; actions are shown on the entry (see &lt;i&gt;Cancel or Rebook Appointment After Pet Adoption&lt;/i&gt;)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2410" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/cancel-or-rebook-appointment-after-pet-adoption" value="Cancel or Rebook Appointment After Pet Adoption" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2670" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/cancel-or-rebook-appointment-after-pet-adoption/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer receives a &lt;i&gt;Pet Adopted Before Visit Notification&lt;/i&gt; (see that story)&#10;&lt;b&gt;THEN&lt;/b&gt; the notification includes options to cancel the appointment or browse other available pets to rebook" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2670" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/cancel-or-rebook-appointment-after-pet-adoption/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer cancels the appointment&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Time Slot&lt;/i&gt; is released back to available&#10;&lt;b&gt;AND&lt;/b&gt; the appointment moves to &lt;i&gt;Cancelled&lt;/i&gt; status in the &lt;i&gt;Appointment List&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2670" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/cancel-or-rebook-appointment-after-pet-adoption/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer chooses to rebook&#10;&lt;b&gt;THEN&lt;/b&gt; the system navigates to the &lt;i&gt;Pet Gallery&lt;/i&gt; with available pets displayed for a new booking&#10;&lt;b&gt;AND&lt;/b&gt; the original cancelled appointment remains in the &lt;i&gt;Past Appointments&lt;/i&gt; section" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2670" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/cancel-or-rebook-appointment-after-pet-adoption/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer neither cancels nor rebooks before the appointment date&#10;&lt;b&gt;THEN&lt;/b&gt; the appointment remains in the system but staff see a &quot;pet adopted&quot; warning on their incoming appointments view&#10;&lt;b&gt;AND&lt;/b&gt; the appointment is treated as a no-show after the date passes" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2670" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/view-incoming-appointments" value="View Incoming Appointments" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2930" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/view-incoming-appointments/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Store Staff&lt;/i&gt; opens the &lt;i&gt;Incoming Appointments&lt;/i&gt; view&#10;&lt;b&gt;THEN&lt;/b&gt; all booked appointments for their &lt;i&gt;Store&lt;/i&gt; are listed, sorted by date/time (soonest first)&#10;&lt;b&gt;AND&lt;/b&gt; each entry shows: customer name, pet name, date/time, and visit note (if any)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2930" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/view-incoming-appointments/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; an appointment's pet has been marked &lt;i&gt;Adopted&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the entry shows a &quot;pet adopted&quot; warning badge&#10;&lt;b&gt;AND&lt;/b&gt; the notification status (&quot;notified&quot; or &quot;not yet notified&quot;) is displayed on the entry" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2930" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/manage-appointments/view-incoming-appointments/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; there are no upcoming appointments&#10;&lt;b&gt;THEN&lt;/b&gt; the view shows an empty state" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2930" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/track-visit-outcomes" value="Track Visit Outcomes" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3195" y="195" width="240" height="60" as="geometry" /></mxCell><mxCell id="book-pet-visit/track-visit-outcomes/check-in-customer" value="Check In Customer" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="3200" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="book-pet-visit/track-visit-outcomes/record-visit-outcome" value="Record Visit Outcome" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="3260" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="book-pet-visit/track-visit-outcomes/record-no-show" value="Record No-Show" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="3320" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="book-pet-visit/track-visit-outcomes/set-follow-up-action" value="Set Follow-Up Action" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="3380" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account" value="Manage Customer Account" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3450" y="120" width="270" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile" value="Manage Profile" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3455" y="195" width="260" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/update-pet-profile" value="Update Pet Profile" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="3460" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/update-pet-profile/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens a &lt;i&gt;Customer Pet Profile&lt;/i&gt; for editing&#10;&lt;b&gt;THEN&lt;/b&gt; all fields are editable: name, species, breed, age, and photo" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3460" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/update-pet-profile/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer saves changes&#10;&lt;b&gt;THEN&lt;/b&gt; the updated profile is persisted immediately&#10;&lt;b&gt;AND&lt;/b&gt; any personalised recommendations that reference pet data reflect the update on the next recommendation cycle" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3460" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/update-pet-profile/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer deletes a &lt;i&gt;Customer Pet Profile&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the profile is removed from &quot;My Pets&quot;&#10;&lt;b&gt;AND&lt;/b&gt; the deletion is confirmed with a &quot;are you sure&quot; prompt" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3460" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications" value="Manage Notifications" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3730" y="120" width="590" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications" value="Send Transactional Notifications" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3735" y="195" width="580" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-appointment-reminder" value="Send Appointment Reminder" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="3740" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-appointment-reminder/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; an &lt;i&gt;Appointment&lt;/i&gt; is 24 hours away&#10;&lt;b&gt;THEN&lt;/b&gt; the system sends an &lt;i&gt;Appointment Reminder&lt;/i&gt; email to the customer&#10;&lt;b&gt;AND&lt;/b&gt; the reminder includes: pet name, store address, date/time, and visit note" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3740" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-appointment-reminder/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the appointment has been cancelled before the reminder trigger time&#10;&lt;b&gt;THEN&lt;/b&gt; no &lt;i&gt;Appointment Reminder&lt;/i&gt; is sent" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3740" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-appointment-reminder/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the pet has been marked &lt;i&gt;Adopted&lt;/i&gt; before the reminder trigger time&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Appointment Reminder&lt;/i&gt; is suppressed&#10;&lt;b&gt;AND&lt;/b&gt; the &lt;i&gt;Pet Adopted Before Visit Notification&lt;/i&gt; takes precedence (if not already sent)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3740" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-appointment-reminder/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the email delivery system is temporarily unavailable&#10;&lt;b&gt;THEN&lt;/b&gt; the reminder is queued for retry within a reasonable window before the appointment" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3740" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-pet-adopted-before-visit-notification" value="Send Pet Adopted Before Visit Notification" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="4000" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-pet-adopted-before-visit-notification/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a pet is marked as &lt;i&gt;Adopted&lt;/i&gt; (see &lt;i&gt;Mark Pet as Adopted&lt;/i&gt;) and there are pending &lt;i&gt;Appointments&lt;/i&gt; for that pet&#10;&lt;b&gt;THEN&lt;/b&gt; the system sends a &lt;i&gt;Pet Adopted Before Visit Notification&lt;/i&gt; to each affected customer&#10;&lt;b&gt;AND&lt;/b&gt; the notification includes: pet name, adoption status, and options to cancel or browse other pets" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="4000" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-pet-adopted-before-visit-notification/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the notification is sent&#10;&lt;b&gt;THEN&lt;/b&gt; it is recorded against the appointment and the notification status is visible on the staff's &lt;i&gt;Incoming Appointments&lt;/i&gt; view" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="4000" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-pet-adopted-before-visit-notification/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the pet is adopted but no pending appointments exist&#10;&lt;b&gt;THEN&lt;/b&gt; no notification is sent" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="4000" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-pet-adopted-before-visit-notification/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the email delivery system is temporarily unavailable&#10;&lt;b&gt;THEN&lt;/b&gt; the notification is queued for retry&#10;&lt;b&gt;AND&lt;/b&gt; the appointment still shows the &quot;pet adopted&quot; badge on both customer and staff views" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="4000" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-visit-follow-up-notification" value="Send Visit Follow-Up Notification" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="4260" y="345" width="50" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>