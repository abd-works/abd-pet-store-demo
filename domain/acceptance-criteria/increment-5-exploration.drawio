<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Story Map" id="story-map"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="purchase-products" value="Purchase Products" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="790" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment" value="Process Payment" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="195" width="780" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/process-digital-wallet-payment-via-paynova" value="Process Digital Wallet Payment via PayNova" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/process-digital-wallet-payment-via-paynova/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects &lt;i&gt;PayNova&lt;/i&gt; (&lt;i&gt;Digital Wallet&lt;/i&gt;) at the payment step&#10;&lt;b&gt;THEN&lt;/b&gt; the system redirects to or embeds the PayNova wallet authentication flow&#10;&lt;b&gt;AND&lt;/b&gt; the customer authorises the payment using their mobile wallet credentials" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/process-digital-wallet-payment-via-paynova/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; PayNova returns a successful payment confirmation&#10;&lt;b&gt;THEN&lt;/b&gt; the order status transitions to &lt;i&gt;Confirmed&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the &lt;i&gt;Payment&lt;/i&gt; is recorded with vendor = PayNova and the vendor's transaction reference&#10;&lt;b&gt;AND&lt;/b&gt; the system proceeds to send the order confirmation (email, page)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/process-digital-wallet-payment-via-paynova/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; PayNova declines the payment (insufficient balance, wallet locked, etc.)&#10;&lt;b&gt;THEN&lt;/b&gt; the customer sees a clear error message with the decline reason (as much as PayNova provides)&#10;&lt;b&gt;AND&lt;/b&gt; the payment step displays options to retry with PayNova, switch to StripeWave, or switch to VaultPay&#10;&lt;b&gt;BUT&lt;/b&gt; no order is created and no confirmation is sent" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/process-digital-wallet-payment-via-paynova/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the PayNova &lt;i&gt;Webhook Callback&lt;/i&gt; arrives after a timeout&#10;&lt;b&gt;THEN&lt;/b&gt; the system reconciles the callback against the pending order (same pattern as StripeWave in Increment 2)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/process-digital-wallet-payment-via-paynova/ac-4" value="&lt;b&gt;WHEN&lt;/b&gt; a logged-in customer completes a PayNova payment&#10;&lt;b&gt;THEN&lt;/b&gt; the system offers to save PayNova as a &lt;i&gt;Saved Payment Method&lt;/i&gt; under the customer account (same save-payment flow as Increment 4, vendor = PayNova)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="685" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/process-buy-now-pay-later-via-vaultpay" value="Process Buy-Now-Pay-Later via VaultPay" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="290" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/process-buy-now-pay-later-via-vaultpay/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects &lt;i&gt;VaultPay&lt;/i&gt; (&lt;i&gt;Buy-Now-Pay-Later&lt;/i&gt;) at the payment step&#10;&lt;b&gt;THEN&lt;/b&gt; the system redirects to or embeds VaultPay's BNPL flow&#10;&lt;b&gt;AND&lt;/b&gt; VaultPay performs the &lt;i&gt;Eligibility Check&lt;/i&gt; and presents the &lt;i&gt;Instalment Plan&lt;/i&gt; to the customer" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/process-buy-now-pay-later-via-vaultpay/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer accepts the &lt;i&gt;Instalment Plan&lt;/i&gt; and VaultPay approves&#10;&lt;b&gt;THEN&lt;/b&gt; the order status transitions to &lt;i&gt;Confirmed&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the &lt;i&gt;Payment&lt;/i&gt; is recorded with vendor = VaultPay and the instalment reference&#10;&lt;b&gt;AND&lt;/b&gt; the system proceeds to send the order confirmation" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/process-buy-now-pay-later-via-vaultpay/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; VaultPay declines the BNPL application (eligibility failed, credit check failed, etc.)&#10;&lt;b&gt;THEN&lt;/b&gt; the customer sees a clear message that BNPL is not available for this transaction&#10;&lt;b&gt;AND&lt;/b&gt; the payment step displays StripeWave and PayNova as alternative options&#10;&lt;b&gt;BUT&lt;/b&gt; no order is created — the decline is VaultPay's decision, not PawPlace's" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/process-buy-now-pay-later-via-vaultpay/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the VaultPay &lt;i&gt;Webhook Callback&lt;/i&gt; arrives after a timeout&#10;&lt;b&gt;THEN&lt;/b&gt; the system reconciles the callback against the pending order (same pattern as StripeWave/PayNova)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/process-buy-now-pay-later-via-vaultpay/ac-4" value="&lt;b&gt;WHEN&lt;/b&gt; a logged-in customer completes a VaultPay payment&#10;&lt;b&gt;THEN&lt;/b&gt; the system offers to save VaultPay as a &lt;i&gt;Saved Payment Method&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; future VaultPay usage pre-fills the customer's VaultPay identity — they still go through the eligibility check per transaction" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="685" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/retry-failed-payment" value="Retry Failed Payment" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="550" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/retry-failed-payment/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a &lt;i&gt;Payment&lt;/i&gt; fails due to a &lt;i&gt;Transient Error&lt;/i&gt; (timeout, vendor 5xx, network issue)&#10;&lt;b&gt;THEN&lt;/b&gt; the system automatically retries the payment through the same &lt;i&gt;Payment Vendor&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the customer sees a &quot;retrying payment&quot; indicator — no manual action required" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="550" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/retry-failed-payment/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;Payment Retry&lt;/i&gt; succeeds&#10;&lt;b&gt;THEN&lt;/b&gt; the order transitions to &lt;i&gt;Confirmed&lt;/i&gt; as if the first attempt had succeeded&#10;&lt;b&gt;AND&lt;/b&gt; the customer sees the &lt;i&gt;Order Confirmation Page&lt;/i&gt; and receives the confirmation email" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="550" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/retry-failed-payment/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;Payment Retry&lt;/i&gt; fails again within the &lt;i&gt;Retry Window&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system retries up to a maximum retry count (e.g. 3 attempts)&#10;&lt;b&gt;AND&lt;/b&gt; after the final retry fails, the customer is notified that payment could not be processed&#10;&lt;b&gt;AND&lt;/b&gt; the payment step displays alternative payment methods and a manual card entry form" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="550" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/retry-failed-payment/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; a &lt;i&gt;Payment&lt;/i&gt; fails due to a &lt;i&gt;Hard Decline&lt;/i&gt; (insufficient funds, card blocked, fraud flag)&#10;&lt;b&gt;THEN&lt;/b&gt; the system does &lt;b&gt;not&lt;/b&gt; automatically retry&#10;&lt;b&gt;AND&lt;/b&gt; the customer is immediately shown the decline reason and offered alternatives (different card, different vendor)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="550" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/retry-failed-payment/ac-4" value="&lt;b&gt;WHEN&lt;/b&gt; a &lt;i&gt;Payment Retry&lt;/i&gt; is in progress and the customer navigates away&#10;&lt;b&gt;THEN&lt;/b&gt; the retry continues in the background&#10;&lt;b&gt;AND&lt;/b&gt; if it succeeds, the order is confirmed and the confirmation email fires&#10;&lt;b&gt;BUT&lt;/b&gt; if all retries exhaust, the order remains unpaid and the customer is notified (via guest email or account notification)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="550" y="685" width="250" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>