<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Story Map" id="story-map"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="browse-product-catalog" value="Browse Product Catalog" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="590" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products" value="Search and Filter Products" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="195" width="580" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/search-products-by-keyword" value="Search Products by Keyword" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/search-products-by-keyword/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer enters a keyword in the &lt;i&gt;Search Bar&lt;/i&gt; and submits&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Search Results&lt;/i&gt; show products whose name, description, category, or brand match the keyword&#10;&lt;b&gt;AND&lt;/b&gt; results are ranked by relevance (closest match first)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/search-products-by-keyword/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the keyword matches no products&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Search Results&lt;/i&gt; show a &quot;no results found&quot; message with suggestions (e.g. &quot;try a different keyword&quot; or popular categories)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/search-products-by-keyword/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer enters a partial keyword (e.g. &quot;kitt&quot; for &quot;kitten food&quot;)&#10;&lt;b&gt;THEN&lt;/b&gt; the search returns relevant matches (prefix matching or fuzzy matching)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/search-products-by-keyword/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer searches from any page (product detail, pet gallery, blog)&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Search Bar&lt;/i&gt; is accessible globally (e.g. in the header)&#10;&lt;b&gt;AND&lt;/b&gt; results navigate to the search results page" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/filter-products" value="Filter Products" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="290" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/filter-products/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer is browsing the &lt;i&gt;Product Catalog&lt;/i&gt; or viewing &lt;i&gt;Search Results&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; &lt;i&gt;Filter Facets&lt;/i&gt; are available: category, pet type, brand, price range, and &lt;i&gt;Stock Availability&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; each facet shows the count of matching products" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/filter-products/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects a filter&#10;&lt;b&gt;THEN&lt;/b&gt; the product list updates immediately to show only matching products&#10;&lt;b&gt;AND&lt;/b&gt; the &lt;i&gt;Active Filters&lt;/i&gt; are shown as removable chips or tags" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/filter-products/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer combines multiple filters (e.g. pet type = &quot;dog&quot; AND category = &quot;food&quot;)&#10;&lt;b&gt;THEN&lt;/b&gt; the results narrow to the intersection of all active filters&#10;&lt;b&gt;AND&lt;/b&gt; facets update their counts to reflect the combined filter state" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/filter-products/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer removes an &lt;i&gt;Active Filter&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the product list expands to include products that were previously hidden by that filter" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/filter-products/ac-4" value="&lt;b&gt;WHEN&lt;/b&gt; all active filters produce zero results&#10;&lt;b&gt;THEN&lt;/b&gt; the product list shows a &quot;no products match your filters&quot; message with a &quot;clear all filters&quot; action" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="685" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/display-low-stock-badge" value="Display Low Stock Badge" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="550" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="find-store" value="Find Store" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="800" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores" value="Locate Stores" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="625" y="195" width="260" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/filter-stores-by-availability-and-specialization" value="Filter Stores by Availability and Specialization" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="630" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/filter-stores-by-availability-and-specialization/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer is browsing the &lt;i&gt;Store List&lt;/i&gt; or &lt;i&gt;Store Map&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; filters are available for: &lt;i&gt;Store Specialization&lt;/i&gt; and &lt;i&gt;Product Availability&lt;/i&gt; (e.g. &quot;stores that have product X in stock&quot;)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="630" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/filter-stores-by-availability-and-specialization/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer filters by &lt;i&gt;Store Specialization&lt;/i&gt; (e.g. &quot;reptile section&quot;)&#10;&lt;b&gt;THEN&lt;/b&gt; only stores with that specialization are shown" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="630" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/filter-stores-by-availability-and-specialization/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer filters by &lt;i&gt;Product Availability&lt;/i&gt; for a specific product&#10;&lt;b&gt;THEN&lt;/b&gt; only stores where that product is &lt;i&gt;In Stock&lt;/i&gt; are shown" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="630" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/filter-stores-by-availability-and-specialization/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; no stores match the combined filters&#10;&lt;b&gt;THEN&lt;/b&gt; a &quot;no stores match your filters&quot; message is shown with a &quot;clear filters&quot; action" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="630" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/personalize-store-experience" value="Personalize Store Experience" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="895" y="195" width="520" height="60" as="geometry" /></mxCell><mxCell id="find-store/personalize-store-experience/set-my-store-preference" value="Set My Store Preference" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="find-store/personalize-store-experience/set-my-store-preference/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a logged-in customer selects &quot;Set as My Store&quot; on a &lt;i&gt;Store Detail&lt;/i&gt; page or from account settings&#10;&lt;b&gt;THEN&lt;/b&gt; the selected store is saved as the customer's &lt;i&gt;My Store&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the preference persists across sessions and devices" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="900" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/personalize-store-experience/set-my-store-preference/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer changes their &lt;i&gt;My Store&lt;/i&gt; preference&#10;&lt;b&gt;THEN&lt;/b&gt; the old preference is replaced with the new one&#10;&lt;b&gt;AND&lt;/b&gt; the tailored experience (see &lt;i&gt;Tailor Experience to Preferred Store&lt;/i&gt;) reflects the change immediately" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="900" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/personalize-store-experience/set-my-store-preference/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; a guest customer tries to set &lt;i&gt;My Store&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; a prompt to log in or register is shown&#10;&lt;b&gt;BUT&lt;/b&gt; the store page is not navigated away from" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="900" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/personalize-store-experience/tailor-experience-to-preferred-store" value="Tailor Experience to Preferred Store" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1160" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="find-store/personalize-store-experience/tailor-experience-to-preferred-store/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has a &lt;i&gt;My Store&lt;/i&gt; set&#10;&lt;b&gt;THEN&lt;/b&gt; &lt;i&gt;Stock Availability&lt;/i&gt; on product pages defaults to the preferred store&#10;&lt;b&gt;AND&lt;/b&gt; the &lt;i&gt;Store Locator&lt;/i&gt; highlights the preferred store" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1160" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/personalize-store-experience/tailor-experience-to-preferred-store/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has a &lt;i&gt;My Store&lt;/i&gt; and enters checkout with &lt;i&gt;Click-and-Collect&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the preferred store is pre-selected in the &lt;i&gt;Store Selector&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the full store list remains available for selecting a different store" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1160" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/personalize-store-experience/tailor-experience-to-preferred-store/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has no &lt;i&gt;My Store&lt;/i&gt; set&#10;&lt;b&gt;THEN&lt;/b&gt; no store-specific tailoring is applied (default behavior from previous increments)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1160" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account" value="Manage Customer Account" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="120" width="270" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile" value="Manage Profile" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1435" y="195" width="260" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/create-pet-profile" value="Create Pet Profile" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1440" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/create-pet-profile/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a logged-in customer opens &quot;My Pets&quot; from account settings&#10;&lt;b&gt;THEN&lt;/b&gt; they see a list of their &lt;i&gt;Customer Pet Profiles&lt;/i&gt; (or an empty state with &quot;add your first pet&quot;)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1440" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/create-pet-profile/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer creates a new &lt;i&gt;Customer Pet Profile&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the form collects: name, species, breed (optional), age or date of birth (optional), and a photo (optional)&#10;&lt;b&gt;AND&lt;/b&gt; the profile is saved to the account" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1440" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/create-pet-profile/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has multiple pets&#10;&lt;b&gt;THEN&lt;/b&gt; each pet has its own profile entry&#10;&lt;b&gt;AND&lt;/b&gt; all are listed under &quot;My Pets&quot;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1440" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/create-pet-profile/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; a guest customer tries to create a pet profile&#10;&lt;b&gt;THEN&lt;/b&gt; a prompt to log in or register is shown" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1440" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products" value="Purchase Products" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="120" width="100" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/check-out" value="Check Out" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1715" y="195" width="60" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/check-out/allow-backorder-purchase" value="Allow Backorder Purchase" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1720" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-store-operations" value="Manage Store Operations" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1820" y="120" width="270" height="60" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory" value="Manage Inventory" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1825" y="195" width="260" height="60" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory/view-inventory-dashboard" value="View Inventory Dashboard" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1830" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory/view-inventory-dashboard/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Store Staff&lt;/i&gt; opens the &lt;i&gt;Inventory Dashboard&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; all products at their store are listed with current &lt;i&gt;Stock Levels&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the dashboard supports search, sort (by name, stock level, category), and filter" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1830" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory/view-inventory-dashboard/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; a product's &lt;i&gt;Stock Level&lt;/i&gt; falls below a configurable threshold&#10;&lt;b&gt;THEN&lt;/b&gt; a &lt;i&gt;Low Stock Alert&lt;/i&gt; badge is shown on that product's row&#10;&lt;b&gt;AND&lt;/b&gt; a &quot;Low stock only&quot; filter is available on the dashboard" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1830" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory/view-inventory-dashboard/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Store Staff&lt;/i&gt; edits a &lt;i&gt;Stock Level&lt;/i&gt; from the dashboard&#10;&lt;b&gt;THEN&lt;/b&gt; the same behavior as &lt;i&gt;Update Product Stock Levels&lt;/i&gt; (Increment 1) applies: immediate persist, real-time customer-facing update, validation" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1830" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory/view-inventory-dashboard/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Store Staff&lt;/i&gt; views the dashboard for the first time after Increment 9 deployment&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Inventory Dashboard&lt;/i&gt; replaces the bare-bones &lt;i&gt;Admin Stock Form&lt;/i&gt; from Increment 1&#10;&lt;b&gt;AND&lt;/b&gt; all existing stock data is intact — no data migration loss" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1830" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory/view-inventory-dashboard/ac-4" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Store Staff&lt;/i&gt; exports inventory data (e.g. CSV)&#10;&lt;b&gt;THEN&lt;/b&gt; the export includes: product name, category, current stock level, and last updated timestamp&#10;&lt;b&gt;AND&lt;/b&gt; the export covers the staff member's store only" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1830" y="685" width="250" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>