<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Story Map" id="story-map"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="browse-product-catalog" value="Browse Product Catalog" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="540" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products" value="Search and Filter Products" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="195" width="260" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/display-real-time-stock-availability" value="Display Real-Time Stock Availability" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/display-real-time-stock-availability/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer views a &lt;i&gt;Product Page&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system displays current &lt;i&gt;Stock Availability&lt;/i&gt; for that &lt;i&gt;Product&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the availability reflects the most recent &lt;i&gt;Stock Levels&lt;/i&gt; (&lt;i&gt;Real-Time&lt;/i&gt;)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/display-real-time-stock-availability/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;Product&lt;/i&gt; is in stock at one or more stores&#10;&lt;b&gt;THEN&lt;/b&gt; the system indicates which &lt;i&gt;Store&lt;/i&gt; or stores have it available" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/display-real-time-stock-availability/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;Product&lt;/i&gt; is out of stock at all stores&#10;&lt;b&gt;THEN&lt;/b&gt; the system clearly indicates the product is currently unavailable&#10;&lt;b&gt;BUT&lt;/b&gt; no backorder, pre-order, or purchase option is offered" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/search-and-filter-products/display-real-time-stock-availability/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Stock Levels&lt;/i&gt; are updated by staff&#10;&lt;b&gt;THEN&lt;/b&gt; subsequent customer views of the &lt;i&gt;Product Page&lt;/i&gt; reflect the updated &lt;i&gt;Stock Availability&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details" value="View Product Details" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="295" y="195" width="260" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details/view-product-details" value="View Product Details" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="300" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details/view-product-details/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects a &lt;i&gt;Product&lt;/i&gt; from the &lt;i&gt;Product Catalog&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system displays the &lt;i&gt;Product Page&lt;/i&gt; with the product name, &lt;i&gt;Description&lt;/i&gt;, and &lt;i&gt;Images&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; &lt;i&gt;Weight and Dimensions&lt;/i&gt; are shown where relevant to the product" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details/view-product-details/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;Product&lt;/i&gt; belongs to one or more categories&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Product Page&lt;/i&gt; shows which &lt;i&gt;Category&lt;/i&gt; or categories the product belongs to" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details/view-product-details/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;Product&lt;/i&gt; has multiple &lt;i&gt;Images&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system displays all available images&#10;&lt;b&gt;AND&lt;/b&gt; navigation controls (arrows, thumbnails) are provided to browse between images" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details/view-product-details/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer navigates the &lt;i&gt;Product Catalog&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; products are organized by &lt;i&gt;Category&lt;/i&gt; for browsing&#10;&lt;b&gt;BUT&lt;/b&gt; no keyword search is available in this increment" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="browse-product-catalog/view-product-details/view-product-details/ac-4" value="&lt;b&gt;WHEN&lt;/b&gt; the customer views a &lt;i&gt;Product Page&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; no purchase, cart, or review actions are available" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="685" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store" value="Find Store" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="790" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores" value="Locate Stores" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="575" y="195" width="780" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/view-store-map" value="View Store Map" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/view-store-map/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens the &lt;i&gt;Store Locator&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system displays all stores as selectable points on a &lt;i&gt;Map View&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; each point is positioned at the store's &lt;i&gt;Geo-Coordinates&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/view-store-map/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects a store point on the &lt;i&gt;Map View&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system displays the store's full address, &lt;i&gt;Operating Hours&lt;/i&gt;, and &lt;i&gt;Contact Details&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/view-store-map/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; multiple stores exist&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Map View&lt;/i&gt; shows all store locations simultaneously without requiring search or filtering" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/view-store-map/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; a visitor is not logged in&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Store Locator&lt;/i&gt; and &lt;i&gt;Map View&lt;/i&gt; are fully accessible without requiring an account" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/view-store-list" value="View Store List" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="840" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/view-store-list/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens the &lt;i&gt;Store Locator&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system offers a &lt;i&gt;List View&lt;/i&gt; of all stores as an alternative to the &lt;i&gt;Map View&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; each entry shows the store name and &lt;i&gt;Address&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="840" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/view-store-list/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects a store from the &lt;i&gt;List View&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system displays the store's full &lt;i&gt;Address&lt;/i&gt;, &lt;i&gt;Operating Hours&lt;/i&gt;, and &lt;i&gt;Contact Details&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="840" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/view-store-list/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;List View&lt;/i&gt; loads&#10;&lt;b&gt;THEN&lt;/b&gt; all stores appear without requiring search or filtering" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="840" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/view-store-list/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; a visitor is not logged in&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;List View&lt;/i&gt; is fully accessible without requiring an account" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="840" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/calculate-distance-to-store" value="Calculate Distance to Store" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1100" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/calculate-distance-to-store/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer provides their location (via &lt;i&gt;Shared Location&lt;/i&gt; or entering a &lt;i&gt;Postcode&lt;/i&gt;)&#10;&lt;b&gt;THEN&lt;/b&gt; the system calculates &lt;i&gt;Distance&lt;/i&gt; from the customer to each &lt;i&gt;Store&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; stores are sorted &lt;i&gt;Nearest-First&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1100" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/calculate-distance-to-store/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has not provided any location&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Store Locator&lt;/i&gt; displays all stores without &lt;i&gt;Distance&lt;/i&gt; information&#10;&lt;b&gt;AND&lt;/b&gt; all stores remain browsable in their default order" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1100" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/calculate-distance-to-store/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Distance&lt;/i&gt; has been calculated&#10;&lt;b&gt;THEN&lt;/b&gt; the distance value appears next to each &lt;i&gt;Store&lt;/i&gt; in both &lt;i&gt;Map View&lt;/i&gt; and &lt;i&gt;List View&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1100" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="find-store/locate-stores/calculate-distance-to-store/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer changes their location input (new &lt;i&gt;Postcode&lt;/i&gt; or re-shared location)&#10;&lt;b&gt;THEN&lt;/b&gt; the system recalculates &lt;i&gt;Distance&lt;/i&gt; for all stores&#10;&lt;b&gt;AND&lt;/b&gt; the &lt;i&gt;Nearest-First&lt;/i&gt; ordering updates accordingly" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1100" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-store-operations" value="Manage Store Operations" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="120" width="270" height="60" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory" value="Manage Inventory" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1375" y="195" width="260" height="60" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory/update-product-stock-levels" value="Update Product Stock Levels" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1380" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory/update-product-stock-levels/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Store Staff&lt;/i&gt; opens the &lt;i&gt;Admin Form&lt;/i&gt; for a &lt;i&gt;Product&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system displays the current &lt;i&gt;Stock Levels&lt;/i&gt; for that product at the selected &lt;i&gt;Store&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; an editable stock quantity field is displayed" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory/update-product-stock-levels/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Store Staff&lt;/i&gt; submits an updated stock quantity&#10;&lt;b&gt;THEN&lt;/b&gt; the system saves the new &lt;i&gt;Stock Levels&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the &lt;i&gt;Stock Availability&lt;/i&gt; shown to customers reflects the change" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory/update-product-stock-levels/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Store Staff&lt;/i&gt; enters an invalid stock value (negative number or non-numeric input)&#10;&lt;b&gt;THEN&lt;/b&gt; the system rejects the update with a clear error message&#10;&lt;b&gt;BUT&lt;/b&gt; the previous &lt;i&gt;Stock Levels&lt;/i&gt; remain unchanged" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-store-operations/manage-inventory/update-product-stock-levels/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Store Staff&lt;/i&gt; updates stock for a &lt;i&gt;Product&lt;/i&gt; at one &lt;i&gt;Store&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; only that store's &lt;i&gt;Stock Levels&lt;/i&gt; for that product are changed&#10;&lt;b&gt;BUT&lt;/b&gt; other stores' stock for the same product remains unaffected" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="615" width="250" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>