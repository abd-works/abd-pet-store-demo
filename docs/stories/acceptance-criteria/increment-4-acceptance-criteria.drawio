<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Story Map" id="story-map"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="manage-customer-account" value="Manage Customer Account" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="3670" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate" value="Register and Authenticate" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="195" width="1820" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/register-account" value="Register Account" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/register-account/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens the &lt;i&gt;Registration Form&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the form collects: email address and password (with confirmation)&#10;&lt;b&gt;AND&lt;/b&gt; the form shows password requirements clearly before submission" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/register-account/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer submits a valid &lt;i&gt;Registration Form&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; a &lt;i&gt;Customer Account&lt;/i&gt; is created with status &lt;i&gt;Unverified&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the system triggers &lt;i&gt;Send Email Verification&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the customer sees a &quot;check your email to verify&quot; confirmation screen" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/register-account/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer submits an email that is already registered&#10;&lt;b&gt;THEN&lt;/b&gt; the form shows an error stating the email is already in use&#10;&lt;b&gt;AND&lt;/b&gt; offers a &quot;Log In instead&quot; link&#10;&lt;b&gt;BUT&lt;/b&gt; does not reveal whether the existing account is verified or not (information leakage prevention)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/register-account/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer submits a password that does not meet requirements&#10;&lt;b&gt;THEN&lt;/b&gt; the form shows which requirements are unmet&#10;&lt;b&gt;BUT&lt;/b&gt; the account is not created until all requirements pass" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/send-email-verification" value="Send Email Verification" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="290" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/send-email-verification/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a &lt;i&gt;Customer Account&lt;/i&gt; is created (registration or guest-to-account conversion)&#10;&lt;b&gt;THEN&lt;/b&gt; the system sends an &lt;i&gt;Email Verification&lt;/i&gt; to the registered email address&#10;&lt;b&gt;AND&lt;/b&gt; the email contains a &lt;i&gt;Verification Link&lt;/i&gt; that is unique and time-limited" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/send-email-verification/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;Verification Link&lt;/i&gt; expires (e.g. after 24 hours)&#10;&lt;b&gt;THEN&lt;/b&gt; clicking the link shows a clear &quot;link expired&quot; message&#10;&lt;b&gt;AND&lt;/b&gt; offers a &quot;resend verification&quot; action" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/send-email-verification/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the email delivery system is temporarily unavailable&#10;&lt;b&gt;THEN&lt;/b&gt; the verification email is queued for retry&#10;&lt;b&gt;AND&lt;/b&gt; the registration confirmation screen tells the customer to expect the email shortly" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/verify-email-address" value="Verify Email Address" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="550" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/verify-email-address/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer clicks a valid, non-expired &lt;i&gt;Verification Link&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Customer Account&lt;/i&gt; transitions to &lt;i&gt;Verified Status&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the customer is redirected to a &quot;you're verified&quot; confirmation page with a prompt to log in" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="550" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/verify-email-address/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer clicks a &lt;i&gt;Verification Link&lt;/i&gt; that has already been used&#10;&lt;b&gt;THEN&lt;/b&gt; the system shows a &quot;already verified&quot; message with a login link&#10;&lt;b&gt;BUT&lt;/b&gt; the account is not re-verified or modified" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="550" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/verify-email-address/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer clicks an expired &lt;i&gt;Verification Link&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system shows a &quot;link expired&quot; message with a &quot;resend verification&quot; action" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="550" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/log-in" value="Log In" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="810" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/log-in/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer submits valid credentials on the &lt;i&gt;Login Form&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; a &lt;i&gt;Session&lt;/i&gt; is created&#10;&lt;b&gt;AND&lt;/b&gt; the customer is redirected to their previous page or account dashboard" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="810" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/log-in/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer submits incorrect credentials&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Login Form&lt;/i&gt; shows a generic &quot;invalid email or password&quot; error&#10;&lt;b&gt;BUT&lt;/b&gt; does not specify which field is wrong (credential enumeration prevention)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="810" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/log-in/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer attempts to log in to an &lt;i&gt;Unverified&lt;/i&gt; account&#10;&lt;b&gt;THEN&lt;/b&gt; the system shows a &quot;please verify your email first&quot; message with a &quot;resend verification&quot; option&#10;&lt;b&gt;BUT&lt;/b&gt; no &lt;i&gt;Session&lt;/i&gt; is created" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="810" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/log-in/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has an active &lt;i&gt;Shopping Cart&lt;/i&gt; from guest browsing and then logs in&#10;&lt;b&gt;THEN&lt;/b&gt; the guest cart is merged into the logged-in customer's cart&#10;&lt;b&gt;AND&lt;/b&gt; if both carts contain the same product, quantities are summed" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="810" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/log-out" value="Log Out" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1070" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/log-out/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects &quot;Log Out&quot;&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Session&lt;/i&gt; is invalidated&#10;&lt;b&gt;AND&lt;/b&gt; the customer is redirected to the home page in a guest state" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1070" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/log-out/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer logs out on one device&#10;&lt;b&gt;THEN&lt;/b&gt; only the &lt;i&gt;Session&lt;/i&gt; on that device is invalidated (other device sessions remain active)&#10;&lt;b&gt;AND&lt;/b&gt; a &quot;Log out everywhere&quot; option is shown that invalidates all sessions across devices when selected" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1070" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/reset-password" value="Reset Password" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1330" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/reset-password/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer requests a password reset by entering their email&#10;&lt;b&gt;THEN&lt;/b&gt; the system sends a &lt;i&gt;Reset Link&lt;/i&gt; to that email (if the account exists)&#10;&lt;b&gt;AND&lt;/b&gt; the same &quot;check your email&quot; message is shown regardless of whether the account exists (information leakage prevention)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1330" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/reset-password/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer clicks a valid, non-expired &lt;i&gt;Reset Link&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; they are taken to a &quot;set new password&quot; form&#10;&lt;b&gt;AND&lt;/b&gt; the new password must meet the same requirements as registration" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1330" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/reset-password/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer submits a new password&#10;&lt;b&gt;THEN&lt;/b&gt; the password is updated and all existing &lt;i&gt;Sessions&lt;/i&gt; are invalidated (the customer must re-login)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1330" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/reset-password/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;Reset Link&lt;/i&gt; has expired or been used&#10;&lt;b&gt;THEN&lt;/b&gt; the customer sees a clear &quot;link expired&quot; message with a &quot;Request new reset&quot; action" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1330" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/maintain-session-across-devices" value="Maintain Session Across Devices" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1590" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/maintain-session-across-devices/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer logs in on a new device&#10;&lt;b&gt;THEN&lt;/b&gt; a new &lt;i&gt;Session&lt;/i&gt; is created for that device&#10;&lt;b&gt;AND&lt;/b&gt; existing sessions on other devices remain active" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1590" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/maintain-session-across-devices/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer's &lt;i&gt;Session Token&lt;/i&gt; expires (inactivity timeout or max duration)&#10;&lt;b&gt;THEN&lt;/b&gt; the customer is redirected to the &lt;i&gt;Login Form&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; any unsaved cart changes are preserved (the cart is tied to the account, not the session)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1590" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/register-and-authenticate/maintain-session-across-devices/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer changes their password (via &lt;i&gt;Reset Password&lt;/i&gt;)&#10;&lt;b&gt;THEN&lt;/b&gt; all &lt;i&gt;Sessions&lt;/i&gt; on all devices are invalidated&#10;&lt;b&gt;AND&lt;/b&gt; the customer must re-authenticate on each device" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1590" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile" value="Manage Profile" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1855" y="195" width="1040" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/save-delivery-address" value="Save Delivery Address" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1860" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/save-delivery-address/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a logged-in customer completes checkout with a new shipping address&#10;&lt;b&gt;THEN&lt;/b&gt; the system offers a &quot;save this address for future orders&quot; option&#10;&lt;b&gt;AND&lt;/b&gt; if accepted, the address is stored in the customer's &lt;i&gt;Address Book&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1860" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/save-delivery-address/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer saves the first address&#10;&lt;b&gt;THEN&lt;/b&gt; that address is automatically marked as the default delivery address" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1860" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/save-delivery-address/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer already has addresses in their &lt;i&gt;Address Book&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the new address is added without replacing existing ones&#10;&lt;b&gt;AND&lt;/b&gt; the account settings &lt;i&gt;Address Book&lt;/i&gt; shows the new entry with a &quot;set as default&quot; option (see &lt;i&gt;Manage Saved Addresses&lt;/i&gt;)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1860" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/manage-saved-addresses" value="Manage Saved Addresses" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2120" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/manage-saved-addresses/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens the &lt;i&gt;Address Book&lt;/i&gt; from their account settings&#10;&lt;b&gt;THEN&lt;/b&gt; all &lt;i&gt;Saved Addresses&lt;/i&gt; are listed with full details&#10;&lt;b&gt;AND&lt;/b&gt; the &lt;i&gt;Default Address&lt;/i&gt; is visually indicated" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2120" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/manage-saved-addresses/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer edits a &lt;i&gt;Saved Address&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the changes are persisted&#10;&lt;b&gt;AND&lt;/b&gt; future checkouts using that address reflect the updated details" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2120" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/manage-saved-addresses/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer deletes a &lt;i&gt;Saved Address&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the address is removed from the &lt;i&gt;Address Book&lt;/i&gt;&#10;&lt;b&gt;BUT&lt;/b&gt; if the deleted address was the &lt;i&gt;Default Address&lt;/i&gt;, the customer is prompted to select a new default (or the most recently added becomes default)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2120" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/manage-saved-addresses/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer sets a different address as &lt;i&gt;Default Address&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the previous default is demoted&#10;&lt;b&gt;AND&lt;/b&gt; the new default is pre-selected during future checkouts" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2120" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/save-payment-method" value="Save Payment Method" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2380" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/save-payment-method/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a logged-in customer completes a payment during checkout&#10;&lt;b&gt;THEN&lt;/b&gt; the system offers a &quot;save this payment method for future orders&quot; option&#10;&lt;b&gt;AND&lt;/b&gt; if accepted, a &lt;i&gt;Token&lt;/i&gt; from the payment vendor is stored — never the raw card number" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2380" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/save-payment-method/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer saves a payment method&#10;&lt;b&gt;THEN&lt;/b&gt; the account stores: last four digits, card type (or vendor label), and the expiry date for display&#10;&lt;b&gt;AND&lt;/b&gt; the &lt;i&gt;Token&lt;/i&gt; is what is used in future transactions — no re-entry of full card details" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2380" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/save-payment-method/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer saves a second payment method&#10;&lt;b&gt;THEN&lt;/b&gt; both are listed in the account settings (see &lt;i&gt;Manage Saved Payment Methods&lt;/i&gt;)&#10;&lt;b&gt;AND&lt;/b&gt; the first saved method remains the default unless the customer changes it" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2380" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/manage-saved-payment-methods" value="Manage Saved Payment Methods" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2640" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/manage-saved-payment-methods/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens the &lt;i&gt;Payment Methods List&lt;/i&gt; from account settings&#10;&lt;b&gt;THEN&lt;/b&gt; all saved methods are shown with: last four digits, card type or vendor, and expiry&#10;&lt;b&gt;AND&lt;/b&gt; the &lt;i&gt;Default Payment Method&lt;/i&gt; is visually indicated" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2640" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/manage-saved-payment-methods/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer removes a &lt;i&gt;Saved Payment Method&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Token&lt;/i&gt; is deleted and the method no longer appears at checkout&#10;&lt;b&gt;BUT&lt;/b&gt; if the removed method was the &lt;i&gt;Default Payment Method&lt;/i&gt;, the customer is prompted to select a new default" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2640" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/manage-profile/manage-saved-payment-methods/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer sets a different method as &lt;i&gt;Default Payment Method&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the previous default is demoted&#10;&lt;b&gt;AND&lt;/b&gt; the new default is pre-selected during future checkouts" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2640" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity" value="Track Activity" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2905" y="195" width="780" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/view-order-history" value="View Order History" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2910" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/view-order-history/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a logged-in customer opens &lt;i&gt;Order History&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; all orders associated with the account are listed, most recent first&#10;&lt;b&gt;AND&lt;/b&gt; each row shows the &lt;i&gt;Order Summary&lt;/i&gt;: order number, date, items (condensed), total, and current status" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2910" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/view-order-history/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects an order from the list&#10;&lt;b&gt;THEN&lt;/b&gt; the full order detail opens: all items, quantities, shipping/billing address, delivery option, payment method (masked), and tracking number (if shipped)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2910" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/view-order-history/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has no orders yet&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Order History&lt;/i&gt; shows an empty state with a prompt to start shopping" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2910" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/view-order-history/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; a guest customer's order was placed before they created an account (same email)&#10;&lt;b&gt;THEN&lt;/b&gt; the guest order is retroactively associated with the new account and appears in &lt;i&gt;Order History&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="2910" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/manage-wishlist" value="Manage Wishlist" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="3170" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/manage-wishlist/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a logged-in customer selects &quot;Add to Wishlist&quot; on a &lt;i&gt;Product Details Page&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the product is added to the customer's &lt;i&gt;Wishlist&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the &quot;Add to Wishlist&quot; button changes to a &quot;Remove from Wishlist&quot; state" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3170" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/manage-wishlist/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer opens their &lt;i&gt;Wishlist&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; all saved &lt;i&gt;Wishlist Items&lt;/i&gt; are shown with: product name, image, price, and current &lt;i&gt;Stock Availability&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3170" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/manage-wishlist/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects &quot;Add to Cart&quot; from a &lt;i&gt;Wishlist Item&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the product is added to the &lt;i&gt;Shopping Cart&lt;/i&gt; (same behavior as adding from the Product Details Page)&#10;&lt;b&gt;BUT&lt;/b&gt; the product remains on the &lt;i&gt;Wishlist&lt;/i&gt; until explicitly removed" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3170" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/manage-wishlist/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer removes a &lt;i&gt;Wishlist Item&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the product is removed from the &lt;i&gt;Wishlist&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the &quot;Add to Wishlist&quot; button on that product's &lt;i&gt;Product Details Page&lt;/i&gt; returns to its default state" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3170" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/manage-wishlist/ac-4" value="&lt;b&gt;WHEN&lt;/b&gt; a guest customer tries to add to wishlist&#10;&lt;b&gt;THEN&lt;/b&gt; a prompt to log in or register is shown, explaining that wishlists require an account&#10;&lt;b&gt;BUT&lt;/b&gt; the product page is not navigated away from — the prompt is dismissible and browsing continues" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3170" y="685" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/reorder-previous-purchase" value="Reorder Previous Purchase" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="3430" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/reorder-previous-purchase/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects &quot;Reorder&quot; on a past order in &lt;i&gt;Order History&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; all products from that order are added to the &lt;i&gt;Shopping Cart&lt;/i&gt; with their original quantities&#10;&lt;b&gt;AND&lt;/b&gt; the customer is taken to the cart to review before checkout" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3430" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/reorder-previous-purchase/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; a product from the original order is no longer available (delisted)&#10;&lt;b&gt;THEN&lt;/b&gt; the available products are added to the cart&#10;&lt;b&gt;AND&lt;/b&gt; a clear message lists which products could not be added and why&#10;&lt;b&gt;BUT&lt;/b&gt; the reorder is not blocked — partial reorder succeeds" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3430" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/reorder-previous-purchase/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; a product from the original order is currently &lt;i&gt;Out of Stock&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the product is added to the cart with a stock warning&#10;&lt;b&gt;AND&lt;/b&gt; a &quot;proceed anyway&quot; option and a &quot;remove&quot; option are shown on that line item" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3430" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-customer-account/track-activity/reorder-previous-purchase/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer already has items in their &lt;i&gt;Shopping Cart&lt;/i&gt; and reorders&#10;&lt;b&gt;THEN&lt;/b&gt; the reordered products are merged into the existing cart&#10;&lt;b&gt;AND&lt;/b&gt; if both contain the same product, quantities are summed" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3430" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products" value="Purchase Products" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3700" y="120" width="540" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/check-out" value="Check Out" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3705" y="195" width="260" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/check-out/select-saved-address-at-checkout" value="Select Saved Address at Checkout" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="3710" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="purchase-products/check-out/select-saved-address-at-checkout/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a logged-in customer reaches the shipping step during checkout&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Address Selector&lt;/i&gt; shows all &lt;i&gt;Saved Addresses&lt;/i&gt; from the &lt;i&gt;Address Book&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the &lt;i&gt;Default Address&lt;/i&gt; is pre-selected" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3710" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/check-out/select-saved-address-at-checkout/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects a &lt;i&gt;Saved Address&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the shipping address fields are auto-filled with that address&#10;&lt;b&gt;AND&lt;/b&gt; the checkout advances to the next step without manual entry" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3710" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/check-out/select-saved-address-at-checkout/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer wants to use a new address not in the &lt;i&gt;Address Book&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; a &quot;use a different address&quot; option reveals the manual &lt;i&gt;Address Form&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; a &quot;save this address&quot; checkbox is shown so the new address is added to the &lt;i&gt;Address Book&lt;/i&gt; when checked (see &lt;i&gt;Save Delivery Address&lt;/i&gt;)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3710" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/check-out/select-saved-address-at-checkout/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; a guest customer (not logged in) reaches the shipping step&#10;&lt;b&gt;THEN&lt;/b&gt; no &lt;i&gt;Address Selector&lt;/i&gt; is shown — only the manual &lt;i&gt;Address Form&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; a prompt to log in or create an account mentions the benefit of saved addresses" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3710" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment" value="Process Payment" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3975" y="195" width="260" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/select-saved-payment-method-at-checkout" value="Select Saved Payment Method at Checkout" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="3980" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/select-saved-payment-method-at-checkout/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a logged-in customer reaches the payment step during checkout&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Payment Selector&lt;/i&gt; shows all &lt;i&gt;Saved Payment Methods&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the &lt;i&gt;Default Payment Method&lt;/i&gt; is pre-selected" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3980" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/select-saved-payment-method-at-checkout/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects a &lt;i&gt;Saved Payment Method&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the payment proceeds using the stored &lt;i&gt;Token&lt;/i&gt; — no card re-entry required&#10;&lt;b&gt;AND&lt;/b&gt; the customer is shown the last four digits and card type for confirmation" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3980" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/select-saved-payment-method-at-checkout/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer wants to use a new payment method not yet saved&#10;&lt;b&gt;THEN&lt;/b&gt; a &quot;use a different payment method&quot; option reveals the manual card entry form&#10;&lt;b&gt;AND&lt;/b&gt; a &quot;save this payment method&quot; checkbox is shown so the new method is stored when checked (see &lt;i&gt;Save Payment Method&lt;/i&gt;)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3980" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="purchase-products/process-payment/select-saved-payment-method-at-checkout/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; a saved payment method's token has expired or been revoked by the vendor&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Payment Selector&lt;/i&gt; marks that method as &quot;expired&quot; or removes it&#10;&lt;b&gt;AND&lt;/b&gt; the remaining valid methods and the manual entry form are displayed as alternatives&#10;&lt;b&gt;BUT&lt;/b&gt; the expired token is never silently used for a charge attempt" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="3980" y="615" width="250" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>