<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Story Map" id="story-map"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="return-products" value="Return Products" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1320" height="60" as="geometry" /></mxCell><mxCell id="return-products/initiate-return" value="Initiate Return" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="195" width="520" height="60" as="geometry" /></mxCell><mxCell id="return-products/initiate-return/initiate-return-from-order-history" value="Initiate Return from Order History" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="return-products/initiate-return/initiate-return-from-order-history/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer selects &quot;Return&quot; on an eligible order in &lt;i&gt;Order History&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system shows which items in the order are &lt;i&gt;Return Eligible&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the customer selects the items and quantities to return, plus a return reason" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/initiate-return/initiate-return-from-order-history/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer submits the &lt;i&gt;Return Request&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system creates the return record, links it to the original order, and shows the next steps (label generation)&#10;&lt;b&gt;AND&lt;/b&gt; the return status appears in the customer's account under the order detail" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/initiate-return/initiate-return-from-order-history/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the order is outside the return window or items are not eligible&#10;&lt;b&gt;THEN&lt;/b&gt; the &quot;Return&quot; action is hidden or disabled with a clear reason (e.g. &quot;return window expired&quot;)&#10;&lt;b&gt;BUT&lt;/b&gt; the order detail is still viewable" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/initiate-return/initiate-return-from-order-history/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the customer has already initiated a return for some items in the order&#10;&lt;b&gt;THEN&lt;/b&gt; those items are shown as &quot;return in progress&quot; and cannot be returned again&#10;&lt;b&gt;BUT&lt;/b&gt; remaining eligible items can still be returned separately" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/initiate-return/generate-return-label-or-qr-code" value="Generate Return Label or QR Code" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="290" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="return-products/initiate-return/generate-return-label-or-qr-code/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;Return Request&lt;/i&gt; is submitted&#10;&lt;b&gt;THEN&lt;/b&gt; the system generates a &lt;i&gt;Return Label&lt;/i&gt; (PDF) and a &lt;i&gt;Return QR Code&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; both are shown on the return confirmation page and emailed to the customer" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/initiate-return/generate-return-label-or-qr-code/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the customer downloads the &lt;i&gt;Return Label&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the label includes: return address, order number, return reference, and carrier barcode" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/initiate-return/generate-return-label-or-qr-code/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the customer chooses the &lt;i&gt;Return QR Code&lt;/i&gt; option&#10;&lt;b&gt;THEN&lt;/b&gt; the QR code is displayable on a mobile device at a carrier drop-off point&#10;&lt;b&gt;AND&lt;/b&gt; it encodes the same return reference as the label" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/initiate-return/generate-return-label-or-qr-code/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the label/QR generation service is temporarily unavailable&#10;&lt;b&gt;THEN&lt;/b&gt; the return is still recorded&#10;&lt;b&gt;AND&lt;/b&gt; the customer is told to check back or contact support for the label&#10;&lt;b&gt;BUT&lt;/b&gt; the return is not cancelled due to label failure" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund" value="Process Refund" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="555" y="195" width="780" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/route-refund-through-original-payment-vendor" value="Route Refund through Original Payment Vendor" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="return-products/process-refund/route-refund-through-original-payment-vendor/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the returned item is received and inspected (or the return is auto-approved)&#10;&lt;b&gt;THEN&lt;/b&gt; the system initiates a &lt;i&gt;Refund&lt;/i&gt; through the &lt;i&gt;Original Payment Vendor&lt;/i&gt; for that order&#10;&lt;b&gt;AND&lt;/b&gt; the refund amount matches the returned items' value" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/route-refund-through-original-payment-vendor/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the original payment was via StripeWave&#10;&lt;b&gt;THEN&lt;/b&gt; the refund routes through StripeWave's refund API&#10;&lt;b&gt;AND&lt;/b&gt; the customer sees the credit on their card statement" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/route-refund-through-original-payment-vendor/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the original payment was via PayNova (digital wallet)&#10;&lt;b&gt;THEN&lt;/b&gt; the refund routes through PayNova's refund API" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/route-refund-through-original-payment-vendor/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the original payment was via VaultPay (BNPL)&#10;&lt;b&gt;THEN&lt;/b&gt; the refund routes through VaultPay's refund API&#10;&lt;b&gt;AND&lt;/b&gt; the instalment plan is adjusted accordingly by VaultPay" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/route-refund-through-original-payment-vendor/ac-4" value="&lt;b&gt;WHEN&lt;/b&gt; the refund request to the vendor fails (vendor downtime, API error)&#10;&lt;b&gt;THEN&lt;/b&gt; the refund is queued for retry&#10;&lt;b&gt;AND&lt;/b&gt; the customer sees &quot;refund processing&quot; status — not &quot;refund failed&quot;&#10;&lt;b&gt;BUT&lt;/b&gt; if retries exhaust, the return status escalates to &quot;refund requires manual review&quot;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="685" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/track-refund-status" value="Track Refund Status" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="820" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="return-products/process-refund/track-refund-status/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the customer views the &lt;i&gt;Order Detail&lt;/i&gt; for a returned order&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Refund Status&lt;/i&gt; is visible: processing, completed, or requires review" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/track-refund-status/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;Refund&lt;/i&gt; is completed by the vendor&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Refund Status&lt;/i&gt; transitions to &lt;i&gt;Completed&lt;/i&gt;&#10;&lt;b&gt;AND&lt;/b&gt; the customer receives a &quot;refund completed&quot; notification (email)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/track-refund-status/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;Refund Status&lt;/i&gt; is &quot;processing&quot; for an extended period&#10;&lt;b&gt;THEN&lt;/b&gt; the &lt;i&gt;Order Detail&lt;/i&gt; shows a note: &quot;refunds typically take X business days depending on your payment provider&quot;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/track-refund-status/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the &lt;i&gt;Refund Status&lt;/i&gt; is &quot;requires review&quot;&#10;&lt;b&gt;THEN&lt;/b&gt; the customer sees a message to contact support&#10;&lt;b&gt;AND&lt;/b&gt; the support team has access to the return and refund details" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/process-in-store-return" value="Process In-Store Return" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="return-products/process-refund/process-in-store-return/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; a customer brings an item to the store for return&#10;&lt;b&gt;THEN&lt;/b&gt; the staff dashboard provides an order lookup by order number or customer email&#10;&lt;b&gt;AND&lt;/b&gt; a &quot;Start Return&quot; action is displayed on the matched order" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/process-in-store-return/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; &lt;i&gt;Store Staff&lt;/i&gt; submits the &lt;i&gt;In-Store Return&lt;/i&gt;&#10;&lt;b&gt;THEN&lt;/b&gt; the system creates a return record linked to the original order&#10;&lt;b&gt;AND&lt;/b&gt; triggers the &lt;i&gt;Refund&lt;/i&gt; through the &lt;i&gt;Original Payment Vendor&lt;/i&gt; (same routing invariant as online returns)&#10;&lt;b&gt;AND&lt;/b&gt; the return appears in the customer's &lt;i&gt;Order History&lt;/i&gt;" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/process-in-store-return/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the original order was placed by a guest (no account)&#10;&lt;b&gt;THEN&lt;/b&gt; the order lookup and return flow work identically using the order number and guest email&#10;&lt;b&gt;AND&lt;/b&gt; the refund routes through the original vendor&#10;&lt;b&gt;BUT&lt;/b&gt; the return is not visible in an &quot;account&quot; because the customer has no account" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="return-products/process-refund/process-in-store-return/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the item is not eligible for return (outside window, wrong condition)&#10;&lt;b&gt;THEN&lt;/b&gt; the staff dashboard shows the ineligibility reason&#10;&lt;b&gt;AND&lt;/b&gt; a &quot;Manager Override&quot; action is displayed, requiring manager approval before the return proceeds" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="615" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications" value="Manage Notifications" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="120" width="270" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications" value="Send Transactional Notifications" style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1355" y="195" width="260" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-return-and-refund-status-update" value="Send Return and Refund Status Update" style="whiteSpace=wrap;html=1;overflow=hidden;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1360" y="345" width="50" height="50" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-return-and-refund-status-update/ac-0" value="&lt;b&gt;WHEN&lt;/b&gt; the return is received and processing begins&#10;&lt;b&gt;THEN&lt;/b&gt; the system sends a &quot;return received&quot; notification to the customer" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1360" y="405" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-return-and-refund-status-update/ac-1" value="&lt;b&gt;WHEN&lt;/b&gt; the refund is completed by the vendor&#10;&lt;b&gt;THEN&lt;/b&gt; the system sends a &quot;refund completed&quot; notification with the refunded amount and the payment method it was returned to" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1360" y="475" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-return-and-refund-status-update/ac-2" value="&lt;b&gt;WHEN&lt;/b&gt; the refund requires manual review (vendor failure, policy exception)&#10;&lt;b&gt;THEN&lt;/b&gt; the system sends a &quot;refund under review&quot; notification with guidance to contact support if needed" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1360" y="545" width="250" height="60" as="geometry" /></mxCell><mxCell id="manage-notifications/send-transactional-notifications/send-return-and-refund-status-update/ac-3" value="&lt;b&gt;WHEN&lt;/b&gt; the email delivery system is temporarily unavailable&#10;&lt;b&gt;THEN&lt;/b&gt; the notification is queued for retry&#10;&lt;b&gt;AND&lt;/b&gt; the return/refund status is still updated in the system (notification failure does not block processing)" style="whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="1360" y="615" width="250" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>