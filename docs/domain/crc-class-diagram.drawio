  <diagram id="page_notification" name="Notification">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="6000" pageHeight="5000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Notification&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ notification subject&lt;br/&gt;+ notification body&lt;br/&gt;+ notification channel&lt;br/&gt;+ sent date&lt;br/&gt;+ delivery status&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ triggering event : Order, Appointment, Pet, Refund, Stock Availability, Payment Confirmation, Tracking Number, Email Verification&lt;br/&gt;+ recipient : Customer Account, Guest Checkout&lt;br/&gt;+ deliver transactional message : Order, Appointment, Confirmation Email, Shipping Notification, Email Verification, Appointment Confirmation Email, Appointment Reminder, Pet Adopted Before Visit Notification, Visit Follow-Up Notification&lt;br/&gt;+ deliver marketing message : Communication Preferences&lt;br/&gt;+ check communication preferences : Communication Preferences&lt;br/&gt;+ queue failed delivery for retry : Confirmation Email, Shipping Notification, Email Verification, Appointment Confirmation Email, Appointment Reminder, Pet Adopted Before Visit Notification, Visit Follow-Up Notification&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
