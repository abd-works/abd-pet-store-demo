        <mxCell id="19" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Refund&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ refund reference&lt;br/&gt;+ refund amount&lt;br/&gt;+ refund date&lt;br/&gt;+ authorizing party&lt;br/&gt;+ refund status&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ originating return : Return&lt;br/&gt;+ route through original vendor : Payment Vendor&lt;br/&gt;+ establish vendor refund API route : StripeWave, PayNova, VaultPay&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
