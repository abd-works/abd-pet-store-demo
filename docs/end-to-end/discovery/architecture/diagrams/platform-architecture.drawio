<mxfile host="65bd71144e">
    <diagram id="platform-architecture" name="Platform Architecture">
        <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="960" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="PawPlace Pet Store — Platform Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1320" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Runtime components, technologies, and the connections between them. Deployment topology (environments, infra nodes, OS images) lives in deployment-architecture.drawio." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="55" width="1320" height="20" as="geometry"/>
                </mxCell>

                <!-- ── BROWSER / CLIENT LAYER ── -->
                <mxCell id="browserLayer" value="Browser / Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=top;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="60" y="90" width="700" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="spa" value="&lt;b&gt;PawPlace React SPA&lt;/b&gt;&#xa;(Client Application)&#xa;&#xa;React 18 · React Router 6&#xa;TanStack Query 5 · Vite 5&#xa;TypeScript 5&#xa;&#xa;Customer + employee UI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="100" y="125" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="cdnBox" value="&lt;b&gt;Static Asset Host / CDN&lt;/b&gt;&#xa;(CDN / Edge)&#xa;&#xa;Serves compiled SPA bundle&#xa;(HTML, JS, CSS) from edge.&#xa;Reduces origin load for&#xa;SPA requests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="430" y="125" width="290" height="110" as="geometry"/>
                </mxCell>

                <!-- ── SERVER LAYER ── -->
                <mxCell id="serverLayer" value="Server Layer — Node.js 20" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=top;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="60" y="310" width="700" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="apiServer" value="&lt;b&gt;PawPlace API Server&lt;/b&gt;&#xa;(Backend Service)&#xa;&#xa;Node.js 20 · Express 4 · Zod 3&#xa;TypeScript 5&#xa;&#xa;Composition root; mounts all&#xa;domain module routers.&#xa;Handles all /api/* routes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="100" y="350" width="310" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="syncWorker" value="&lt;b&gt;Inventory B2B Sync Worker&lt;/b&gt;&#xa;(Background Worker)&#xa;&#xa;Node.js 20 · TypeScript 5 · Zod 3&#xa;&#xa;Receives inbound supplier&#xa;inventory webhooks; sends&#xa;outbound fulfilment confirmations.&#xa;Separate process from API Server." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="440" y="350" width="290" height="160" as="geometry"/>
                </mxCell>

                <!-- ── DATA LAYER ── -->
                <mxCell id="dataLayer" value="Data Layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="60" y="590" width="700" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="mongodb" value="&lt;b&gt;MongoDB Atlas&lt;/b&gt;&#xa;(Data Store — MongoDB 7)&#xa;&#xa;Managed cloud cluster.&#xa;All domain aggregates:&#xa;products, stores, orders,&#xa;customers (planned)." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=20;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="200" y="625" width="300" height="110" as="geometry"/>
                </mxCell>

                <!-- ── THIRD-PARTY INTEGRATIONS ── -->
                <mxCell id="extLayer" value="Third-Party Integrations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;verticalAlign=top;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="820" y="310" width="540" height="440" as="geometry"/>
                </mxCell>
                <mxCell id="storeLocator" value="&lt;b&gt;Store Locator API&lt;/b&gt;&#xa;(Third-Party Integration)&#xa;&#xa;External geolocation service.&#xa;Called read-only by API Server&#xa;for store proximity queries.&#xa;&#xa;Protocol: HTTPS / REST + JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="860" y="350" width="460" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="supplierFeed" value="&lt;b&gt;Pet Supplier B2B Feed&lt;/b&gt;&#xa;(Third-Party Integration)&#xa;&#xa;Authoritative stock source.&#xa;→ Sends inventory update webhooks&#xa;   to Sync Worker (HTTPS POST)&#xa;← Receives fulfilment confirmations&#xa;   from Sync Worker (HTTPS REST)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="860" y="530" width="460" height="190" as="geometry"/>
                </mxCell>

                <!-- ── CONNECTIONS ── -->

                <!-- Browser fetches SPA bundle from CDN -->
                <mxCell id="e1" value="HTTPS (SPA bundle)" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" parent="1" source="cdnBox" target="spa" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- SPA calls API Server -->
                <mxCell id="e2" value="HTTPS / REST + JSON (/api/*)" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" parent="1" source="spa" target="apiServer" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- API Server → MongoDB -->
                <mxCell id="e3" value="MongoDB wire protocol (TLS)" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" parent="1" source="apiServer" target="mongodb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Sync Worker → MongoDB -->
                <mxCell id="e4" value="MongoDB wire protocol (TLS)" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" parent="1" source="syncWorker" target="mongodb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- API Server → Store Locator API -->
                <mxCell id="e5" value="HTTPS / REST + JSON (outbound, read-only)" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" parent="1" source="apiServer" target="storeLocator" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Supplier → Sync Worker (inbound webhook) -->
                <mxCell id="e6" value="Inventory webhook (HTTPS POST)" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;exitX=0;exitY=0.4;entryX=1;entryY=0.4;dashed=1;" parent="1" source="supplierFeed" target="syncWorker" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Sync Worker → Supplier (outbound confirmation) -->
                <mxCell id="e7" value="Fulfilment confirmation (HTTPS REST)" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" parent="1" source="syncWorker" target="supplierFeed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Legend -->
                <mxCell id="legendTitle" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="800" width="100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="leg1" value="Client / browser" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="60" y="825" width="150" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="leg2" value="Server / backend service" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="225" y="825" width="180" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="leg3" value="Background worker" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="420" y="825" width="160" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="leg4" value="Data store" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="595" y="825" width="120" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="leg5" value="Third-party integration" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="730" y="825" width="180" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="leg6" value="Solid arrow = synchronous call" style="text;html=1;align=left;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="925" y="825" width="230" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="leg7" value="Dashed arrow = async / event-driven" style="text;html=1;align=left;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="825" width="270" height="28" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
