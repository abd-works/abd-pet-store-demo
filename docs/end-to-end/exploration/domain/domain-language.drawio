<mxfile host="drawio_tools.py">
  <diagram id="page_product_catalog" name="Product Catalog">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Product Catalog&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ owns the browsable, searchable collection of pet supplies and is the single source of truth for what is available for sale&lt;br/&gt;+ provides filtering and search so customers can narrow results by category, pet type, or brand : Category&lt;br/&gt;+ owns the customer review and rating system — reviews attach social proof directly to product : Customer Review, Product&lt;br/&gt;+ collaborates with Order by supplying current product prices at purchase time and with Customer Account through wishlist links back to product : Order, Product, Customer Account, Wishlist, Product&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;no other abstraction may duplicate *product* identity, *stock availability* trut...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="260" height="134" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Product&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ carries multiple product images, a description, and weight and dimensions where relevant : Product Images&lt;br/&gt;+ belongs to at least one category and may belong to several simultaneously : Category&lt;br/&gt;+ exposes real-time stock availability so checkout never surprises the customer with a backorder : Stock Availability&lt;br/&gt;+ accumulates customer reviews that contribute to an aggregate star rating : Customer Reviews&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must always belong to at least one *category*; must always expose current *stock...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="260" height="134" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Product Image&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ composes under a single product, ideally covering multiple angles : Product&lt;br/&gt;+ presents on the product detail page to support purchase decisions : Product&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Category&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ organizes product into browsable groups — by product type, pet type, or brand : Product&lt;br/&gt;+ allows a product to belong to multiple category simultaneously; category assignments are not exclusive : Product, Category, Category&lt;br/&gt;+ acts as a filter facet enabling customers to narrow catalog results without scrolling through irrelevant items&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Customer Review&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ attaches a one-to-five star rating, optional written text, and optional photo to a product : Product&lt;br/&gt;+ aggregates with other customer reviews into the product&amp;#x27;s star rating and review count : Customer Reviews, Product&lt;br/&gt;+ shows photo reviews where a customer&amp;#x27;s pet uses the product, adding social proof : Product&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must be attached to exactly one *product*; only one *customer review* per *custo...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="320" width="260" height="118" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Stock Availability&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ computes from stock level at each store (quantity on hand minus reserved quantity) : Stock Level, Store&lt;br/&gt;+ displays on the product page per store so a walk-in customer knows where to find the item : Product Page, Store&lt;br/&gt;+ gates the purchase path — a product that is out of stock at all stores must not offer add to cart (Increment 2: cart item quantity reflects stock availability at render time; checkout blocked when unavailable) : Product, Add To Cart, Cart Item, Stock Availability&lt;br/&gt;+ reserves quantity when an order is confirmed so concurrent shoppers cannot oversell the same stock level : Order, Stock Level&lt;br/&gt;+ updates immediately when store employee changes stock level via the admin dashboard : Store Employee, Stock Level, Admin Dashboard&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must always be current; stale availability that permits checkout of an unavailab...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Stock Level&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(property on stock availability)* — numeric quantity of a *product* held at a given *store*&lt;br/&gt;+ is edited by store employee through the admin dashboard stock form : Store Employee, Admin Dashboard&lt;br/&gt;+ drives the customer-visible stock availability status for that store and product pair : Stock Availability, Store, Product&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Product Page&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(presentation surface)* — detail view for a single *product* showing name, *description*, *product images*, *category* membership, and per-store *stock availability*&lt;br/&gt;+ in Increment 2 exposes add to cart when stock availability permits at least one store; defers customer review and keyword search : Add To Cart, Stock Availability, Store, Customer Review&lt;br/&gt;+ is reachable from product catalog category browsing and from the shopping cart for quantity review : Product Catalog, Shopping Cart&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="600" width="260" height="94" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_pet" name="Pet">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Pet&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is an available animal classified by species and breed, showcased in a browsable gallery but explicitly not purchasable through the site : Species, Breed&lt;br/&gt;+ presents a pet profile with species, breed, age, pet photos, temperament assessment, and health record details the store is comfortable sharing : Pet Profile, Species, Breed, Pet Photos, Temperament Assessment, Health Record&lt;br/&gt;+ is located at exactly one store and shows the customer which store and how far away it is : Store, Store&lt;br/&gt;+ drives the appointment booking call-to-action — account-gated; never a purchase path : Appointment&lt;br/&gt;+ transitions through lifecycle states managed by store staff via pet lifecycle events: available, adoption-in-progress, adopted : Pet Lifecycle Events&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must always be associated with exactly one *store* and exactly one *species*; mu...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Species&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is the top-level animal classification grouping pet records in the gallery — dog, cat, bird, fish, small mammal, reptile : Pet&lt;br/&gt;+ serves as the primary filter dimension on the pet gallery so customers can narrow results to a single animal type before browsing breed details : Pet, Breed&lt;br/&gt;+ groups coarser than breed — one species contains many breed values (e.g. species &amp;quot;dog&amp;quot; contains Golden Retriever, Labrador, Poodle) : Breed, Species, Breed, Species&lt;br/&gt;+ shows as a gallery tab or filter facet on the customer-facing pet browsing surface&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;every *pet* must belong to exactly one *species*&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="260" height="134" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Breed&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ provides fine-grained filtering within a species for customers who know the animal type they prefer : Species&lt;br/&gt;+ shows on the pet profile alongside age, temperament assessment, and health record : Pet Profile, Temperament Assessment, Health Record&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Pet Photo&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is an image on a pet profile showing the animal to prospective visitors : Pet Profile&lt;br/&gt;+ composes under a pet; store staff upload new pet photos as part of managing the pet&amp;#x27;s listing : Pet, Pet Photos, Pet&lt;br/&gt;+ drives engagement on the pet gallery page : Pet&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Temperament Assessment&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ surfaces on the pet profile to help customers decide whether to book a visit : Pet Profile&lt;br/&gt;+ updates based on staff observation over time&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="320" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Health Record&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ captures medical and care history for a pet that the store is comfortable sharing — vaccinations, vet check dates, treatments : Pet&lt;br/&gt;+ surfaces on the pet profile to reassure prospective visitors : Pet Profile&lt;br/&gt;+ exposes only details store staff choose to share publicly&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Pet Lifecycle Event&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ records a state change in a pet&amp;#x27;s status — typically: available, adoption-in-progress, or adopted : Pet&lt;br/&gt;+ is recorded by store staff when a pet&amp;#x27;s circumstances change : Pet&lt;br/&gt;+ derives the pet&amp;#x27;s current status from the most recent pet lifecycle event and shows it on the pet profile : Pet, Pet Lifecycle Event, Pet Profile&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Pet Source&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ records the provenance of a pet — e.g., rescued, breeder-supplied, or transferred from another store : Pet, Store&lt;br/&gt;+ informs store staff context and may surface on the pet profile where appropriate : Pet Profile&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;every *pet* must trace to exactly one *pet source*&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="600" width="260" height="102" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Pet Lineage&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ captures the breed parentage of a pet — relevant for registered pedigrees or cross-breed documentation : Breed, Pet&lt;br/&gt;+ may surface on the pet profile for customers interested in parentage when considering adoption : Pet Profile&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="600" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Pet Profile&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is the online presentation of a store pet: its breed, age, pet photos, temperament assessment, health record, pet source, and pet lineage : Pet, Breed, Pet Photos, Temperament Assessment, Health Record, Pet Source, Pet Lineage&lt;br/&gt;+ is maintained by store staff — uploading new pet photos, recording pet lifecycle events such as &amp;quot;adopted,&amp;quot; and updating assessments : Pet Photos, Pet Lifecycle Events&lt;br/&gt;+ drives the appointment call-to-action and must never expose a purchase path : Appointment&lt;br/&gt;+ is distinct from customer pet — pet profile describes a store animal available for adoption; customer pet describes an animal the customer already owns : Customer Pet, Pet Profile, Customer Pet&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="260" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_appointment" name="Appointment">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Appointment&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ binds a verified customer account, a pet, and a store into a scheduled visit — *account-gated*: guest sessions cannot book : Customer Account, Pet, Store, Account-gated&lt;br/&gt;+ captures a date, time slot, and optional visit note (e.g., &amp;quot;I have two kids under five&amp;quot;) : Time Slot&lt;br/&gt;+ triggers an appointment reminder the day before and surfaces on the staff appointments view : Appointment Reminder, Staff Appointments View&lt;br/&gt;+ records in the customer account&amp;#x27;s appointment history (past and upcoming) : Customer Account&lt;br/&gt;+ tracks through check-in, visit outcome, no-show, appointment cancellation, or appointment rebooking : Check-in, Visit Outcome, No-show, Appointment Cancellation, Appointment Rebooking&lt;br/&gt;+ sends pet adopted notification to the customer when its pet transitions to adopted before the visit date : Pet Adopted Notification, Pet&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must reference exactly one *pet* and one *store*; must have a confirmed date and...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="260" height="166" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Time Slot&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is an available date-and-time window for a pet visit scoped to a specific store&amp;#x27;s operating hours : Pet, Store&lt;br/&gt;+ presents to the customer during the booking flow, filtered by store and date : Store&lt;br/&gt;+ becomes unavailable to other customers once booked for an appointment : Appointment&lt;br/&gt;+ releases back to available when an appointment is cancelled before the visit date : Appointment&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Availability Slot&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is an alias for time slot — both terms appear in source material; time slot is the canonical term in this model : Time Slot, Time Slot&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Visit Outcome&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ records the result of a completed appointment — for example, adoption agreed, not a match, or follow-up requested : Appointment&lt;br/&gt;+ is recorded by store staff after the customer&amp;#x27;s visit&lt;br/&gt;+ feeds into the customer&amp;#x27;s appointment history and informs any follow-up action the store initiates : Appointment, Follow-up Action&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Check-in&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ records a customer&amp;#x27;s physical arrival at the store for their appointment : Store, Appointment&lt;br/&gt;+ transitions the appointment from scheduled to in-progress : Appointment&lt;br/&gt;+ is triggered by store staff when the customer presents at the desk&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="320" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;No-show&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ marks an appointment where the customer did not arrive within the expected window and did not cancel : Appointment&lt;br/&gt;+ is recorded by store staff to release the time slot and update the appointment history : Time Slot, Appointment&lt;br/&gt;+ may trigger a notification to the customer with a rebooking offer : Notification&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Follow-up Action&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ attaches to the visit outcome and is tracked per appointment : Visit Outcome, Appointment&lt;br/&gt;+ triggers a visit follow-up notification when the staff logs the action with customer-visible content : Visit Follow-up Notification&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Appointment Cancellation&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ releases the time slot back to available so another customer may book it : Time Slot&lt;br/&gt;+ records the cancellation in the customer account&amp;#x27;s appointment history : Customer Account&lt;br/&gt;+ may be prompted by the customer themselves or offered automatically when a pet adopted notification is delivered : Pet Adopted Notification&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="600" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Appointment Rebooking&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ links to the cancelled appointment for history and context : Appointment&lt;br/&gt;+ follows the same booking flow as a new appointment — the customer selects a new pet, store, and time slot : Appointment, Pet, Store, Time Slot&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must reference a newly selected *pet* and *time slot*; must not re-use the *time...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="600" width="260" height="102" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Staff Appointments View&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is the store-employee surface listing all incoming appointment bookings for the store, sorted by upcoming date : Appointment, Store&lt;br/&gt;+ shows each appointment&amp;#x27;s customer name, pet name, date, time slot, and current status (upcoming, checked-in, visit complete, no-show, cancelled) : Appointment, Pet, Time Slot&lt;br/&gt;+ flags appointment records where the associated pet has been adopted — staff see a &amp;quot;pet adopted&amp;quot; warning on those rows : Appointment, Pet&lt;br/&gt;+ supports check-in, visit outcome recording, and no-show marking from within the view : Visit Outcome, No-show&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="260" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_store" name="Store">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Store&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ holds identity and operational details: address, geo-coordinates, operating hours, contact info, and specializations&lt;br/&gt;+ hosts pet and provides time slot for appointment booking : Pet, Time Slot, Appointment&lt;br/&gt;+ fulfills click-and-collect orders when selected as the pickup location : Click-and-collect&lt;br/&gt;+ calculates distance from the customer&amp;#x27;s shared location or entered postcode&lt;br/&gt;+ tailors the browsing experience when set as the customer&amp;#x27;s preferred store&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must always have a valid address, geo-coordinates, and operating hours&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Store Locator&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ provides map view and list view of all store without requiring search or filtering in Increment 1 : Map View, List View, Store&lt;br/&gt;+ calculates distance from the customer&amp;#x27;s shared location or entered postcode and sorts nearest-first when location is provided : Distance, Shared Location, Postcode, Nearest-first&lt;br/&gt;+ shows all stores in default order when no location is provided&lt;br/&gt;+ displays each store&amp;#x27;s address, operating hours, and contact details when selected on either view : Store, Address, Operating Hours, Contact Details&lt;br/&gt;+ positions each store on the map view at its geo-coordinates : Store, Map View, Geo-coordinates&lt;br/&gt;+ in later increments supports filtering by specialization and &amp;quot;my store&amp;quot; preference (requires customer account) : Customer Account&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="260" height="142" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Map View&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(property on store locator)* — geographic display of all *store* locations as selectable points at their *geo-coordinates*&lt;br/&gt;+ shows distance next to each point when the customer has provided location : Distance&lt;br/&gt;+ is fully accessible without a customer account in Increment 1 : Customer Account&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;List View&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(property on store locator)* — sequential readable list of all *store* entries with name and *address*&lt;br/&gt;+ shows distance next to each entry when the customer has provided location : Distance&lt;br/&gt;+ is fully accessible without a customer account in Increment 1 : Customer Account&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Geo-coordinates&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(property on store)* — latitude and longitude positioning the *store* on the *map view*&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;every *store* must have valid *geo-coordinates*&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="320" width="260" height="86" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Address&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(property on store)* — street address of the *store* shown in *list view* and the store detail panel&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Operating Hours&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(property on store)* — times when the *store* is open to the public; shown in the store detail panel&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Contact Details&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(property on store)* — phone, email, or other reachability information; shown in the store detail panel&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="600" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Distance&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(computed value)* — proximity from the customer&amp;#x27;s provided location (*shared location* or *postcode*) to each *store*&lt;br/&gt;+ recalculates when the customer changes location input&lt;br/&gt;+ sorts store results nearest-first when present : Store, Nearest-first&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="600" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Postcode&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(customer input)* — text the customer enters to represent their location for *distance* calculation&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Shared Location&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(customer input)* — device-based geolocation the customer opts to share for *distance* calculation&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="880" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Nearest-first&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(sort order)* — ranking of *store* results with smallest *distance* first&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="880" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Click-and-collect&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is one of two delivery option choices in Increment 3 — order online and pick up at a customer-selected pickup store : Delivery Option, Pickup Store&lt;br/&gt;+ records the chosen pickup store on the order at checkout; no shipping address is required : Pickup Store, Order, Shipping Address&lt;br/&gt;+ saves on shipping costs and brings the customer into the physical store : Store&lt;br/&gt;+ triggers pickup fulfillment — store employee prepares items and marks the order ready, then confirms handoff when the customer collects : Pickup Fulfillment, Store Employee, Order&lt;br/&gt;+ moves the order lifecycle through confirmed → ready for pickup → collected for click-and-collect paths : Order, Confirmed, Ready For Pickup, Collected&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must reference a specific *pickup store* as the collection location&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1160" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Pickup Store&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(property on click-and-collect)* — the *store* the customer selects at checkout for order collection&lt;br/&gt;+ displays on the order confirmation page and in the confirmation email with address and operating hours : Order Confirmation Page, Confirmation Email, Address, Operating Hours&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="1160" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Pickup Fulfillment&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is the store-side workflow for preparing and handing off click-and-collect order : Click-and-collect, Order&lt;br/&gt;+ surfaces pending order in the click-and-collect queue on the admin dashboard, sorted oldest first : Order, Click-and-collect Queue, Admin Dashboard&lt;br/&gt;+ transitions an order from confirmed to ready for pickup when store employee marks items prepared : Order, Confirmed, Ready For Pickup, Store Employee&lt;br/&gt;+ transitions an order from ready for pickup to collected when store employee confirms customer handoff : Order, Ready For Pickup, Collected, Store Employee&lt;br/&gt;+ shows guest email on the queue so staff can contact the customer when stock issues arise at preparation time : Guest Email&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;preparation and handoff must occur at the *pickup store* recorded on the *order*&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="1160" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Click-and-collect Queue&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(presentation surface on admin dashboard)* — staff view of confirmed click-and-collect *order* pending *pickup fulfillment*&lt;br/&gt;+ lists order number, order line item details, and customer guest email or name : Order, Order Line Item, Guest Email&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1440" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Order Queue&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(presentation surface on admin dashboard)* — unified staff view of confirmed *order* across *standard delivery* and *click-and-collect*&lt;br/&gt;+ lists order number, order line item details, delivery type label, and customer guest email or name : Order, Order Line Item, Guest Email&lt;br/&gt;+ routes store employee to ship-to-home or click-and-collect fulfillment detail per delivery option : Store Employee, Delivery Option&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="1440" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Ship-to-home Fulfillment&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is the store-side workflow for packing and dispatching standard delivery order : Standard Delivery, Order&lt;br/&gt;+ surfaces pending ship-to-home order in the order queue on the admin dashboard, sorted oldest first alongside click-and-collect order : Order, Order Queue, Admin Dashboard, Click-and-collect, Order&lt;br/&gt;+ shows the shipping address and items to pack when store employee selects a shipping order : Shipping Address, Store Employee, Order&lt;br/&gt;+ transitions an order from confirmed to fulfilled when store employee marks items packed and ready for dispatch : Order, Confirmed, Fulfilled, Store Employee&lt;br/&gt;+ prompts for a tracking number at fulfillment time — recommended but not blocking in Increment 3 : Tracking Number&lt;br/&gt;+ triggers shipping notification when a tracking number is entered at fulfillment or added later : Shipping Notification, Tracking Number&lt;br/&gt;+ transitions order status from fulfilled to shipped when dispatch is confirmed with tracking number : Order Status, Fulfilled, Shipped, Tracking Number&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;packing and dispatch must reflect the *shipping address* recorded on the *order*&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="1440" width="260" height="182" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_customer_account" name="Customer Account">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Customer Account&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ registers via email and password, creating an account verification status of unverified until email verification completes : Account Verification Status, Email Verification&lt;br/&gt;+ authenticates via login and logout; supports password reset with session invalidation on password change&lt;br/&gt;+ maintains one or more customer session across devices without frequent arbitrary expiry : Customer Session&lt;br/&gt;+ aggregates order history, wishlist, address book, saved payment method, and preferred store : Order History, Wishlist, Address Book, Saved Payment Method, Store&lt;br/&gt;+ retroactively associates prior guest checkout order placed with the same email when the customer later registers : Guest Checkout, Order&lt;br/&gt;+ drives account-only features — wishlist, saved address, saved payment method, order history, reorder — only after email verification succeeds : Wishlist, Saved Address, Saved Payment Method, Order History, Reorder, Email Verification&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must always have a unique, verified email before account-only features unlock; *...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="260" height="166" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Customer Session&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is the authenticated context created when a customer logs in successfully&lt;br/&gt;+ persists across visits on the same device until logout, inactivity timeout, or password reset&lt;br/&gt;+ allows multiple concurrent sessions per customer account across different devices : Customer Account&lt;br/&gt;+ invalidates on logout for the current device; supports &amp;quot;log out everywhere&amp;quot; to invalidate all sessions&lt;br/&gt;+ merges guest shopping cart into the account cart when login follows guest browsing : Shopping Cart&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;unverified accounts must not receive a *customer session* with account-only feat...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Email Verification&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is the mandatory confirmation process that transitions account verification status to verified on the customer account : Account Verification Status, Customer Account&lt;br/&gt;+ sends a verification link to the registered email when an account is created or when resend is requested : Verification Link&lt;br/&gt;+ queues for retry when email delivery is temporarily unavailable&lt;br/&gt;+ blocks login and account-only features until the customer confirms ownership&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;account-only features must not unlock until *email verification* succeeds&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="260" height="134" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Verification Link&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(property on email verification)* — unique, time-limited, one-time-use link in the verification email&lt;br/&gt;+ expires after a configured window (for example 24 hours) and offers resend when expired or already used&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Account Verification Status&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ (type property on customer account) — unverified or verified label gating account-only features : (type Property On Customer Account)&lt;br/&gt;+ remains unverified until the customer completes email verification via a valid verification link : Email Verification, Verification Link&lt;br/&gt;+ blocks customer session creation with account-only access when unverified : Customer Session&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="320" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Guest Checkout&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ allows a customer to complete a purchase without creating a customer account : Customer Account&lt;br/&gt;+ collects guest email, name, and billing address for every transaction; collects shipping address when standard delivery is selected : Guest Email, Billing Address, Shipping Address, Standard Delivery&lt;br/&gt;+ remains available alongside logged-in checkout — registration and login are optional paths, not prerequisites&lt;br/&gt;+ promotes customer account creation after purchase by surfacing the value of order history, saved address, and reorder — prompt is dismissible and does not block the completed order : Customer Account, Order History, Saved Address, Reorder, Order&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;guest details must not persist beyond the transaction; only the *order* record r...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="260" height="134" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Guest Email&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(property on guest checkout)* — email address collected during checkout for *confirmation email* and staff outreach on *pickup fulfillment*&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must be valid before checkout advances to *payment*&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="260" height="86" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Address Book&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ aggregates all saved address on a customer account for reuse at checkout and in account settings : Saved Address, Customer Account&lt;br/&gt;+ designates one default address pre-selected on the shipping step unless the customer chooses another : Default Address&lt;br/&gt;+ accepts new entries from checkout (&amp;quot;save this address&amp;quot;) and from account settings management&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="600" width="260" height="94" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Saved Address&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ allows customers to hold multiple saved address and select among them at checkout : Saved Address&lt;br/&gt;+ pre-fills the checkout shipping step when selected; supports edit and delete from account settings&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;deleting the *default address* requires selecting a new default when other *save...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="600" width="260" height="102" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Default Address&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ *(property on saved address)* — the *saved address* pre-selected on the shipping step at checkout&lt;br/&gt;+ is assigned automatically to the first saved address; customer may change default in account settings : Saved Address&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Wishlist&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ persists across customer session as part of the customer account : Customer Session, Customer Account&lt;br/&gt;+ links back to the Product Catalog for current price and stock availability : Product Catalog, Stock Availability&lt;br/&gt;+ requires a logged-in, verified customer account — guest customers see a login prompt instead : Customer Account&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must be owned by exactly one *customer account*; guest sessions do not have *wis...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="880" width="260" height="118" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Wishlist Item&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is one product entry on a wishlist with current catalog price and stock availability at display time : Product, Wishlist, Stock Availability&lt;br/&gt;+ adds to shopping cart without removing itself from the wishlist until explicitly removed : Shopping Cart, Wishlist&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must reference exactly one *product* on one *wishlist*&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="880" width="260" height="102" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Communication Preferences&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ governs what marketing notification a customer receives — promotional emails, restock alert, pet care tips, and event notifications : Notification, Restock Alert&lt;br/&gt;+ offers granular opt-in and opt-out by category&lt;br/&gt;+ is stored on the customer account but enforced by Notification at delivery time : Customer Account, Notification&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;marketing *notification* must never be sent without explicit opt-in for the rele...&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1160" width="260" height="118" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Customer Pet&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ is the customer&amp;#x27;s own pet record held within their customer account: name, breed, age, and dietary needs : Customer Account, Breed&lt;br/&gt;+ powers smart behaviors such as reorder reminders when purchase frequency suggests the customer is likely running low on food&lt;br/&gt;+ enables personalized recommendations based on the customer&amp;#x27;s existing animals&lt;br/&gt;+ is distinct from pet (Pet KA) — a customer pet describes an animal the customer already owns; a pet is a store animal available for adoption : Pet, Customer Pet, Pet&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="1160" width="260" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_order" name="Order">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="601" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Order&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ captures the complete purchase: product via order line item : Order Line Item, Billing Address, Payment&lt;br/&gt;+ provides the entry point for return on eligible orders : Return, Order History, Return Eligibility&lt;br/&gt;+ moves through click-and-collect or ship-to-home lifecycle : Click-and-Collect, Ship-To-Home Fulfillment&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must have at least one order line item, a delivery option, a billing address, a completed payment&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="602" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Return&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ validates return eligibility within the return window : Return Eligibility, Return Window&lt;br/&gt;+ captures a return request specifying returned items and return reason : Return Request, Returned Items, Return Reason&lt;br/&gt;+ generates a return label and return QR code : Return Label, Return QR Code&lt;br/&gt;+ tracks return status through lifecycle : Return Status&lt;br/&gt;+ triggers refund routing through the original payment vendor : Refund, Payment Vendor&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must reference exactly one originating order; refund must route through original vendor&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="603" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Return Request&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ specifies order line items to return, quantities, and return reason : Order Line Item, Return Reason&lt;br/&gt;+ creates the return record and links to originating order : Return, Order&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must be made against an order that passes return eligibility&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="604" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Return Eligibility&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ determines whether an order or items qualify based on return window : Return Window&lt;br/&gt;+ hides or disables the Return action when not eligible : Order History&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;ineligible items must show a clear reason&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="360" y="180" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="605" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Return Window&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ configured time period after delivery within which a return may be initiated&lt;br/&gt;+ checked by return eligibility when customer selects Return : Return Eligibility&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="360" y="310" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="606" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Return Reason&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ customer-selected or staff-recorded explanation for returning items : Return&lt;br/&gt;+ informs inspection policy for auto-approval&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="660" y="40" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="607" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Returned Items&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ subset of order line items and quantities being sent back : Order Line Item&lt;br/&gt;+ tracks per-item return status when inspected individually : Return Status&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;returned quantities cannot exceed ordered minus previously returned&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="660" y="150" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="608" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Return Status&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ lifecycle: initiated, label generated, shipped back, received, inspected, refund processing, completed&lt;br/&gt;+ surfaces on order detail and order status page : Order History, Order Status Page&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="660" y="280" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="609" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Return Label&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ printable PDF with return address, order number, return reference, carrier barcode : Order&lt;br/&gt;+ shown on return confirmation page and emailed to customer : Notification&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must encode the same return reference as the return QR code&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="610" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Return QR Code&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ mobile-displayable code for carrier drop-off : Return Label&lt;br/&gt;+ encodes the same return reference as the return label&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="470" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="611" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;In-Store Return&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ store-employee-initiated return via order lookup : Store, Order&lt;br/&gt;+ follows same refund routing invariant as online returns : Refund, Payment Vendor&lt;br/&gt;+ supports guest order returns using order number and guest email : Guest Email&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must be recorded against the original order; must route refund through original vendor&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="612" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Manager Override&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ staff escalation allowing in-store return when eligibility blocks : In-Store Return, Return Eligibility&lt;br/&gt;+ requires explicit manager approval, not available online : Admin Dashboard&lt;br/&gt;+ records approving manager and override reason for audit&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="360" y="620" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="613" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Restocking&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ replenishment of stock availability when returned items pass inspection : Stock Availability, Returned Items&lt;br/&gt;+ fires asynchronously after return status transitions to inspected : Return Status&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="660" y="470" width="260" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_payment" name="Payment">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="614" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Payment&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ financial transaction triggered by a confirmed order : Order&lt;br/&gt;+ processes through StripeWave, PayNova, or VaultPay : Payment Vendor, Payment Method Selector&lt;br/&gt;+ initiates payment retry on transient error : Payment Retry, Transient Error&lt;br/&gt;+ surfaces hard decline without retry : Hard Decline&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must always be associated with exactly one order; must not confirm order until payment confirmation succeeds&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="615" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Payment Vendor&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ integrated third-party payment processor behind unified checkout&lt;br/&gt;+ handles webhook callback and payment confirmation : Webhook Callback, Payment Confirmation&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="616" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;StripeWave&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ credit and debit card gateway : Payment Vendor&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="660" y="40" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="617" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;PayNova&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ digital wallet integration with one-tap mobile wallet : Payment Vendor&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="660" y="130" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="618" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;VaultPay&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ buy-now-pay-later integration with eligibility check : Payment Vendor, Eligibility Check&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="660" y="220" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="619" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Refund&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ reverses a payment through the original payment vendor API : Payment Vendor, Return&lt;br/&gt;+ triggered when return is received and inspection passes : Return, Return Status&lt;br/&gt;+ handles vendor failure through refund retry : Refund Retry&lt;br/&gt;+ tracks refund status visible to the customer : Refund Status&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must always route through the vendor that handled the original transaction; amount must match returned items value&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="620" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Refund Status&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ lifecycle state: processing, completed, or requires review&lt;br/&gt;+ transitions to completed when vendor confirms credit : Payment Vendor&lt;br/&gt;+ transitions to requires review when refund retry exhausts : Refund Retry&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must not show refund failed to the customer&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="360" y="230" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="621" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Refund Retry&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ automatic re-attempt of failed refund through same vendor API : Payment Vendor, Refund&lt;br/&gt;+ on exhaustion transitions refund status to requires review : Refund Status&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must always use same payment vendor as original refund attempt&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="360" y="370" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="622" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Payment Retry&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ re-attempts failed payment through same vendor for transient error : Payment, Transient Error&lt;br/&gt;+ confirms order on success in background : Order, Payment Confirmation&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must never retry a hard decline&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="623" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Payment Method Selector&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ presents all vendor options at checkout payment step : StripeWave, PayNova, VaultPay&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="660" y="320" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="624" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Saved Payment Method&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ tokenized record of vendor credential on customer account : Customer Account, Payment Vendor&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must store only vendor token, never raw credentials&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="260" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_notification" name="Notification">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="625" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Notification&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ delivers transactional messages triggered by lifecycle events&lt;br/&gt;+ fires confirmation email on order confirmed : Confirmation Email, Order&lt;br/&gt;+ fires return/refund notifications on return lifecycle : Return Received Notification, Refund Completed Notification&lt;br/&gt;+ delivers marketing messages gated by communication preferences : Communication Preferences&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;transactional notification must always fire; marketing must never fire without opt-in&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="626" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Confirmation Email&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ transactional notification when order payment confirmation succeeds : Order, Payment Confirmation&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="627" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Shipping Notification&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ transactional notification when tracking number recorded on ship-to-home order : Tracking Number, Order&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="660" y="40" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="628" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Appointment Reminder&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ transactional notification sent day before scheduled appointment : Appointment, Customer Account&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:9px;color:#666;&quot;&gt;&lt;i&gt;must fire for every upcoming appointment; must not fire for cancelled&lt;br/&gt;&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
